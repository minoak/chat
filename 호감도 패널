<style>
/* ============================================
   Belladonna Academy · Affinity Panel (Tarot v3)
   캐릭터 호감도 + 죄악도(메인) + 세팅
   rpg_status_panel과 톤 통일
   ============================================ */

body { font-family: 'Noto Serif KR', '나눔명조', '바탕', Batang, Georgia, serif; }

/* Toggle inputs (hidden) */
#character-toggle, #tab-none, #main-section, #sub-section, #settings-section { display: none; }

/* ============================================
   Side panel — slide from right
   ============================================ */
.characters-panel {
  position: fixed; right: 0; top: 0;
  width: 40%;
  max-width: 540px;
  height: 100vh;
  background: #150e1f;
  border-left: 1.5px solid #b8965c;
  box-shadow: -10px 0 30px rgba(0,0,0,0.7);
  z-index: 990;
  overflow-y: auto;
  box-sizing: border-box;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(.2,.6,.2,1);
  color: #ebe2d0;
  padding: 30px 28px 60px;
}
#character-toggle:checked ~ .characters-panel { transform: translateX(0); }

.characters-panel::-webkit-scrollbar { width: 6px; }
.characters-panel::-webkit-scrollbar-thumb { background: #6e5634; }
.characters-panel::-webkit-scrollbar-track { background: #0a070f; }

@media (max-width: 768px) {
  .characters-panel { width: 100%; max-width: none; }
}

/* Toggle button (right side) */
.buttons-container {
  position: fixed; right: 22px; top: 60px;
  display: flex; flex-direction: column; gap: 14px;
  z-index: 1000;
}
.btn-personae {
  width: 52px; height: 52px;
  border-radius: 50%;
  border: 1.2px solid #b8965c;
  background: #150e1f;
  color: #c98da0;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, serif;
  font-size: 20px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.5);
  position: relative;
  transition: all 0.25s;
}
.btn-personae::before {
  content: "";
  position: absolute; inset: -5px;
  border: 0.5px solid rgba(184,150,92,0.32);
  border-radius: 50%;
}
.btn-personae::after { content: "♡"; }
.btn-personae:hover { background: #1a1226; }

/* ============================================
   Panel header
   ============================================ */
.panel-header {
  text-align: center;
  margin-bottom: 22px;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(184,150,92,0.32);
}
.panel-header .roundel {
  width: 38px; height: 38px;
  border: 1.2px solid #b8965c;
  border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  margin: 0 auto 10px;
  color: #c98da0;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 18px;
  position: relative;
}
.panel-header .roundel::before {
  content: ""; position: absolute; inset: -5px;
  border: 0.5px solid rgba(184,150,92,0.32);
  border-radius: 50%;
}
.panel-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-weight: 500;
  font-size: 30px;
  color: #ebe2d0;
  line-height: 1;
  margin: 0;
}
.panel-subtitle {
  font-family: Georgia, serif;
  font-size: 10px;
  letter-spacing: 0.55em;
  color: #b8965c;
  text-transform: uppercase;
  font-variant: small-caps;
  margin-top: 8px;
}

/* ============================================
   Tab controls
   ============================================ */
.tab-controls {
  display: flex;
  gap: 6px;
  justify-content: center;
  margin-top: 16px;
}
.tab-btn {
  flex: 1;
  max-width: 130px;
  padding: 9px 6px;
  background: transparent;
  border: 1px solid rgba(184,150,92,0.55);
  color: #b8965c;
  font-family: Georgia, serif;
  font-size: 10px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  font-variant: small-caps;
  cursor: pointer;
  text-align: center;
  transition: all 0.2s;
}
.tab-btn:hover { color: #d4b577; border-color: #d4b577; background: rgba(184,150,92,0.08); }

#main-section:checked ~ .characters-panel .tab-btn[for="main-section"],
#sub-section:checked ~ .characters-panel .tab-btn[for="sub-section"],
#settings-section:checked ~ .characters-panel .tab-btn[for="settings-section"] {
  background: #d4b577;
  color: #150e1f;
  border-color: #d4b577;
  font-weight: 500;
}

/* ============================================
   Content visibility
   ============================================ */
.empty-state, .main-content, .sub-content, .settings-content { display: none; }
#tab-none:checked ~ .characters-panel .empty-state { display: block; }
#main-section:checked ~ .characters-panel .main-content { display: block; }
#sub-section:checked ~ .characters-panel .sub-content { display: block; }
#settings-section:checked ~ .characters-panel .settings-content { display: block; }

/* Empty state */
.empty-state {
  text-align: center;
  padding: 60px 20px;
}
.empty-state h3 {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 22px;
  color: #d4b577;
  margin: 0 0 14px;
}
.empty-state p {
  font-family: 'Noto Serif KR', serif;
  font-size: 14px;
  color: rgba(235,226,208,0.7);
  line-height: 1.7;
  margin: 0;
}

/* ============================================
   Character cards
   ============================================ */
.character-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  padding: 20px 0;
}
.character-card {
  position: relative;
  background: #1a1226;
  border: 1px solid rgba(184,150,92,0.4);
  padding: 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.character-card::before {
  content: "";
  position: absolute; inset: 4px;
  border: 0.5px solid rgba(184,150,92,0.22);
  pointer-events: none;
}
.character-card > * { position: relative; z-index: 1; }

.char-img-container {
  width: 180px; height: 220px;
  border: 1.5px solid #b8965c;
  margin-bottom: 14px;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #2a1d3a, #1a1226);
}
.sub-content .char-img-container { width: 160px; height: 200px; }
.char-img {
  width: 150%; height: 150%;
  object-fit: contain;
  object-position: center;
}

.char-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-weight: 500;
  font-size: 19px;
  color: #d4b577;
  text-align: center;
  width: 100%;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(184,150,92,0.32);
  margin-bottom: 12px;
}
.char-name .char-icon { font-style: normal; margin-right: 6px; }
.sub-content .char-name { font-size: 17px; }

/* Affinity (heart) — gauge + value */
.heart-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  margin: 6px 0 4px;
}
.heart-icon { color: #c98da0; font-size: 15px; }
.heart-bar {
  flex: 1;
  height: 6px;
  background: rgba(20,14,30,0.6);
  border: 1px solid rgba(184,150,92,0.4);
  overflow: hidden;
  max-width: 160px;
}
.heart-fill {
  height: 100%;
  background: linear-gradient(90deg, #c98da0, #d4b577);
  transition: width 0.3s ease;
}
.heart-percent {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 14px;
  color: #d4b577;
  min-width: 38px;
  text-align: right;
}

/* Affinity Edit button (alertInput trigger) */
.affinity-control {
  display: flex;
  gap: 8px;
  padding: 7px 10px;
  background: rgba(201,141,160,0.06);
  border: 1px solid rgba(201,141,160,0.25);
  margin: 8px 0;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}
.affinity-label {
  font-family: Georgia, serif;
  font-size: 9px;
  letter-spacing: 0.35em;
  color: #b8965c;
  text-transform: uppercase;
  font-variant: small-caps;
}
.affinity-edit {
  flex: 1;
  background: transparent;
  border: 1px solid rgba(184,150,92,0.55);
  color: #b8965c;
  font-family: Georgia, serif;
  font-size: 10px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  font-variant: small-caps;
  padding: 7px 10px;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  max-width: 200px;
}
.affinity-edit::before { content: "〈"; color: rgba(184,150,92,0.6); font-style: italic; font-family: Georgia, serif; }
.affinity-edit::after  { content: "〉"; color: rgba(184,150,92,0.6); font-style: italic; font-family: Georgia, serif; }
.affinity-edit:hover { color: #d4b577; border-color: #d4b577; background: rgba(184,150,92,0.08); }
.affinity-edit:hover::before, .affinity-edit:hover::after { color: #d4b577; }

/* Sin thermometer (main only) */
.sin-row {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 10px 8px;
  background: rgba(122,42,61,0.08);
  border: 1px solid rgba(122,42,61,0.35);
  margin: 10px 0 4px;
  width: 100%;
  box-sizing: border-box;
}
.sin-left, .sin-right {
  flex: 1; height: 22px;
  background: rgba(20,14,30,0.6);
  border: 1px solid rgba(184,150,92,0.32);
  overflow: hidden;
  position: relative;
}
.sin-left { direction: rtl; }
.sin-left-fill {
  height: 100%;
  background: linear-gradient(90deg, #7a2a3d, #c98da0);
  direction: ltr;
}
.sin-right-fill {
  height: 100%;
  background: linear-gradient(90deg, #b8965c, #d4b577);
}
.sin-icon {
  padding: 0 8px;
  font-size: 18px;
  color: #c98da0;
  flex-shrink: 0;
}
.sin-val {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-family: Georgia, serif;
  font-size: 10px;
  color: #ebe2d0;
  font-weight: 600;
  z-index: 1;
}
.sin-val.l { right: 4px; direction: ltr; }
.sin-val.r { left: 4px; }

.sin-controls {
  display: flex;
  gap: 6px;
  margin: 4px 0 0;
  width: 100%;
}
.sin-control-group {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 5px 6px;
  background: rgba(184,150,92,0.04);
  border: 1px solid rgba(184,150,92,0.2);
}
.sin-label-mini {
  font-family: Georgia, serif;
  font-size: 9px;
  letter-spacing: 0.3em;
  color: #b8965c;
  text-transform: uppercase;
  font-variant: small-caps;
  margin-right: 2px;
}
.sin-btn {
  width: 36px; height: 22px;
  background: transparent;
  border: 1px solid rgba(184,150,92,0.55);
  color: #b8965c;
  font-family: Georgia, serif;
  font-size: 10px;
  cursor: pointer;
  transition: all 0.15s;
}
.sin-btn:hover { color: #d4b577; border-color: #d4b577; background: rgba(184,150,92,0.08); }

/* Tooltip (hover) */
.char-tooltip {
  width: 100%;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  border-top: 1px solid rgba(184,150,92,0.22);
  margin-top: 0;
  padding: 0 6px;
  transition: max-height 0.25s ease, opacity 0.25s ease, padding 0.2s ease, margin-top 0.2s ease;
  text-align: center;
  box-sizing: border-box;
}
.character-card:hover .char-tooltip {
  max-height: 140px;
  opacity: 1;
  margin-top: 12px;
  padding: 10px 6px 4px;
}
.char-tooltip h4 {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 13px;
  color: #d4b577;
  margin: 0 0 6px;
}
.char-tooltip p {
  font-family: 'Noto Serif KR', serif;
  font-size: 12px;
  color: rgba(235,226,208,0.78);
  line-height: 1.55;
  margin: 0;
}

/* ============================================
   Settings
   ============================================ */
.settings-content { padding: 20px 0; }
.settings-card {
  position: relative;
  background: #1a1226;
  border: 1px solid rgba(184,150,92,0.4);
  padding: 22px 20px;
}
.settings-card::before {
  content: "";
  position: absolute; inset: 4px;
  border: 0.5px solid rgba(184,150,92,0.22);
  pointer-events: none;
}
.settings-card > * { position: relative; z-index: 1; }
.settings-card h2 {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 22px;
  color: #ebe2d0;
  text-align: center;
  margin: 0 0 20px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(184,150,92,0.32);
}
.settings-section {
  margin-bottom: 24px;
}
.settings-section h3 {
  font-family: Georgia, serif;
  font-size: 11px;
  letter-spacing: 0.45em;
  color: #d4b577;
  text-transform: uppercase;
  font-variant: small-caps;
  margin: 0 0 8px;
  text-align: center;
}
.settings-section p {
  font-family: 'Noto Serif KR', serif;
  font-size: 12px;
  color: rgba(235,226,208,0.7);
  line-height: 1.6;
  margin: 0 0 12px;
  text-align: center;
}
.settings-grid {
  display: grid;
  gap: 8px;
  margin-bottom: 10px;
}
.settings-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
.settings-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
.settings-btn {
  background: transparent;
  border: 1px solid rgba(184,150,92,0.55);
  color: #b8965c;
  font-family: Georgia, serif;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-variant: small-caps;
  padding: 12px 10px;
  cursor: pointer;
  transition: all 0.2s;
}
.settings-btn:hover { color: #d4b577; border-color: #d4b577; background: rgba(184,150,92,0.08); }
.settings-btn.danger {
  color: #c98da0;
  border-color: rgba(201,141,160,0.55);
}
.settings-btn.danger:hover { color: #ffffff; border-color: #c98da0; background: rgba(201,141,160,0.1); }
.settings-status {
  padding: 10px;
  background: rgba(20,14,30,0.6);
  border: 1px solid rgba(184,150,92,0.32);
  text-align: center;
  font-family: Georgia, serif;
  font-size: 12px;
}
.settings-status .lbl { color: #b8965c; font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase; font-variant: small-caps; margin-right: 6px; }
.settings-status .val { color: #d4b577; font-style: italic; }
.settings-tip {
  margin-top: 14px;
  padding: 12px 14px;
  background: rgba(184,150,92,0.06);
  border-left: 2px solid #b8965c;
  font-family: 'Noto Serif KR', serif;
  font-size: 12px;
  color: rgba(235,226,208,0.75);
  line-height: 1.6;
}
.settings-tip em { color: #d4b577; font-style: italic; }
</style>

