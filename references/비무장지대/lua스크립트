listenEdit("editDisplay", function(triggerId, data, meta)
    -- 이미지 태그 변환: <img="..."> → background-image div
    data = data:gsub('<img="(.-)">', function(imageName)
        return '<div class="image-container" style="background-image: url(\'{{raw::' .. imageName .. '}}\');"></div>'
    end)

    -- meta 정보가 있고 마지막 메시지인지 확인
    if meta and meta.index then
        local chatLength = getChatLength(triggerId)
        local position = meta.index - chatLength

        -- 마지막 메시지(-1)에만 버튼 추가
        if position == -1 then
            -- END 마커 확인 (메인 모델이 출력 완료)
            local hasEndMarker = data:find("■END■", 1, true)

            -- 이미 리롤 버튼이 있는지 확인
            local hasRerollButton = data:find('risu%-btn="reroll_auxiliary"', 1, true)

            -- END 마커 있고 리롤 버튼 없으면 추가
            if hasEndMarker and not hasRerollButton then
                local rerollButton = [[

<div style="margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.1);text-align:right;">
<button type="button" risu-btn="reroll_auxiliary" style="all:unset;display:inline-block;background:rgba(100,100,120,0.3);border:1px solid rgba(150,150,170,0.4);border-radius:6px;padding:6px 12px;font-size:12px;color:#a0a0b0;cursor:pointer;transition:all 0.2s;" onmouseover="this.style.background='rgba(120,120,140,0.4)';this.style.borderColor='rgba(170,170,190,0.5)'" onmouseout="this.style.background='rgba(100,100,120,0.3)';this.style.borderColor='rgba(150,150,170,0.4)'">🔄 보조모델 리롤</button>
</div>]]
                data = data .. rerollButton
            end
        end
    end

    return data
end)

