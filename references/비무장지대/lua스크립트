-- Affection prompt function for DMZ characters
setAffectionPromptDMZ = async(function(triggerId, charName, displayName)
    local current_score = getState(triggerId, charName .. "_affection") or 0
    local prompt_text = displayName .. "의 새 호감도를 입력하세요.\n(현재: " .. current_score .. ")\n범위: -500 ~ +500"
    local userInput = alertInput(triggerId, prompt_text):await()

    if userInput then
        local new_score = tonumber(userInput)
        if new_score then
            -- Round and clamp to range
            new_score = math.floor(new_score + 0.5)
            new_score = math.max(-500, math.min(500, new_score))

            -- Update affection value
            setState(triggerId, charName .. "_affection", new_score)
            setChatVar(triggerId, charName .. "_affection", tostring(new_score))

            -- Reload display to show updated value
            reloadDisplay(triggerId)
        else
            alertError(triggerId, "올바른 숫자를 입력해주세요.")
        end
    end
end)

