function processOutput(triggerId)
    local chatHistory = getFullChat(triggerId)
    if not chatHistory or #chatHistory == 0 then
        return
    end
    
    local lastIndex = #chatHistory - 1
    local latestMessage = chatHistory[#chatHistory]
    local mainOutput = latestMessage.data
    
    if not mainOutput or mainOutput == "" then
        return
    end
    
    -- 이미 처리된 메시지 스킵
    if mainOutput:find("■★PROCESSED★■", 1, true) then
        return
    end
    
    -- ◇ 마커 또는 END 마커 확인
    local hasImageHint = mainOutput:find("◇[^◇]+◇") ~= nil
    local metaLine = extractMetaLine(mainOutput)
    local hasMetaLine = metaLine ~= nil
    local hasEndMarker = mainOutput:find("■END■", 1, true) ~= nil

    if not hasImageHint and not hasMetaLine and not hasEndMarker then
        return
    end

    -- 메타라인 직접 파싱 (보조모델 호출 전에 먼저 처리)
    if metaLine then
        parseMetaLineDirect(triggerId, metaLine)
    end

    -- 컨텍스트 (메타라인 파싱 후 갱신된 값 사용)
    local context = getContext(triggerId)

    -- 보조모델 프롬프트 생성
    local prompt = generateAuxiliaryPrompt(mainOutput, context)

    -- 보조모델 호출
    local auxResponse, err = callAuxiliaryModel(triggerId, prompt)
    
    local modifiedOutput = mainOutput
    
    if auxResponse then
        -- 이미지 태그 변환 적용
        modifiedOutput = applyImageFixes(modifiedOutput, auxResponse)
        
        -- 메타/호감도 파싱 및 저장
        parseMetaLine(triggerId, auxResponse)
    end
    
    -- 마커 제거
    modifiedOutput = removeMarkers(modifiedOutput)

    -- 처리 완료 표시
    modifiedOutput = modifiedOutput .. "<!-- ■★PROCESSED★■ -->"
    modifiedOutput = modifiedOutput .. "<!-- ■END■ -->"

    -- 메시지 업데이트
    setChat(triggerId, lastIndex, modifiedOutput)
end

