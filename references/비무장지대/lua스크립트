_G["reroll_auxiliary"] = function(triggerId)
    local chatHistory = getFullChat(triggerId)
    if not chatHistory or #chatHistory < 2 then
        return false
    end

    -- 마지막에서 두 번째 메시지 (임시 메시지 앞)
    local chatIndex = #chatHistory - 2
    local lastMessage = chatHistory[chatIndex + 1]

    -- AI 메시지인지 확인
    if lastMessage.role ~= "char" then
        return false
    end

    local mainOutput = lastMessage.data

    -- PROCESSED 마커와 END 마커 제거
    local cleanMessage = mainOutput:gsub("<!%-%- ■★PROCESSED★■ %-%->", "")
    cleanMessage = cleanMessage:gsub("<!%-%- ■END■ %-%->", "")

    -- 컨텍스트
    local context = getContext(triggerId)

    -- 보조모델 프롬프트 생성
    local prompt = generateAuxiliaryPrompt(cleanMessage, context)

    -- 보조모델 재호출
    local auxResponse, err = callAuxiliaryModel(triggerId, prompt)

    local modifiedOutput = cleanMessage

    if auxResponse then
        -- 이미지 태그 변환 적용
        modifiedOutput = applyImageFixes(modifiedOutput, auxResponse)

        -- 메타/호감도 파싱 및 저장
        parseMetaLine(triggerId, auxResponse)
    end

    -- 마커 제거
    modifiedOutput = removeMarkers(modifiedOutput)

    -- 처리 완료 표시
    modifiedOutput = modifiedOutput .. "<!-- ■★PROCESSED★■ -->"
    modifiedOutput = modifiedOutput .. "<!-- ■END■ -->"

    -- 메시지 업데이트 (-2 = 임시 메시지 앞)
    setChat(triggerId, -2, modifiedOutput)

    return true
end

