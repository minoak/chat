            envNum = "7"
        end
    end

    if not envNum then
        return nil
    end

    local envMap = {
        ["1"] = "gop",
        ["2"] = "infantry",
        ["3"] = "tank",
        ["4"] = "mortar",
        ["5"] = "engineer",
        ["6"] = "recon",
        ["7"] = "marine"
    }

    local unitType = envMap[envNum]

    if unitType then
        -- $greeting 변수를 숫자로 설정 (퍼스트 메시지 내용의 조건문과 매칭)
        setChatVar(triggerId, "$greeting", tonumber(envNum))

        -- 환경 초기화
        local success, msg = initializeEnvironment(triggerId, unitType)

        if success then
            -- 환경 선택 완료
            setState(triggerId, "awaiting_env_selection", false)
        end
    end

    return nil
end)

