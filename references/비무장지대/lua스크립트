-- ============================================

onButtonClick = async(function(triggerId, code)
    if code == "reroll_auxiliary" then
        -- 재생성 중 표시
        addChat(triggerId, 'char', '<div style="padding:20px;text-align:center;color:#00d4ff;font-weight:600;">🔄 보조모델 재생성 중...</div>')

        -- reroll_auxiliary 함수 호출
        local success = pcall(_G["reroll_auxiliary"], triggerId)

        -- 임시 메시지 제거
        removeChat(triggerId, -1)

        if not success then
            log("❌ 리롤 실패")
        else
            log("✅ 보조모델 리롤 완료")
        end
    end

    -- 호감도 설정 핸들러
    local affCharMatch = code:match("^aff_(%w+)_set$")
    if affCharMatch then
        local charName = affCharMatch
        local currentAff = getState(triggerId, charName .. "_affection") or 0

        local input = prompt("호감도를 입력하세요 (-500 ~ 500)\n현재: " .. currentAff)
        if input then
            local newValue = tonumber(input)
            if newValue and newValue >= MIN_AFFECTION and newValue <= MAX_AFFECTION then
                setState(triggerId, charName .. "_affection", newValue)
                setChatVar(triggerId, charName .. "_affection", tostring(newValue))
                log("✅ " .. charName .. " 호감도: " .. currentAff .. " → " .. newValue)
            else
                log("❌ 잘못된 값: " .. tostring(input))
            end
        end
    end
end)

