-- ============================================

function setAffection(triggerId, characterName, value)
    local name = nameMap[characterName] or characterName:lower()

    local isValid = false
    for _, char in ipairs(characters) do
        if char == name then
            isValid = true
            break
        end
    end

    if isValid then
        local newScore = math.max(MIN_AFFECTION, math.min(MAX_AFFECTION, value))
        setState(triggerId, name .. "_affection", newScore)
        setChatVar(triggerId, name .. "_affection", tostring(newScore))
        return true, name .. " = " .. newScore
    else
        return false, "Unknown character: " .. characterName
    end
end

function getAffection(triggerId, characterName)
    local name = nameMap[characterName] or characterName:lower()
    return getState(triggerId, name .. "_affection") or 0
end


