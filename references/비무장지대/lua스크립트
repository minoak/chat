function applyImageFixes(text, auxResponse)
    local modified = text
    
    for original, replacement in auxResponse:gmatch("%[IMG_FIX:◇(.-)◇→(<img=[^%]]+>)%]") do
        local pattern = "◇" .. original:gsub("([%.%+%-%*%?%[%]%(%)%%])", "%%%1") .. "◇"
        modified = modified:gsub(pattern, replacement .. "\n\n", 1)
    end
    
    return modified
end

function parseMetaLine(triggerId, auxResponse)
    -- [META:...] 파싱 (시간/장소만 - 호감도는 parseMetaLineDirect에서 처리)
    local meta = auxResponse:match("%[META:([^%]]+)%]")
    if meta then
        local date, time, location, situation = meta:match("([^|]+)|([^|]+)|([^|]+)|([^|]+)")
        if date then
            setChatVar(triggerId, "current_date", date:match("^%s*(.-)%s*$"))
            setChatVar(triggerId, "current_time", time:match("^%s*(.-)%s*$"))
            setChatVar(triggerId, "current_location", location:match("^%s*(.-)%s*$"))
            setChatVar(triggerId, "current_situation", situation:match("^%s*(.-)%s*$"))
        end
    end
end

function removeMarkers(text)
    local modified = text
    
    -- ◇...◇ 이미지 힌트 제거
    modified = modified:gsub("◇[^◇]+◇", "")
    
    -- ◇ ... 메타 라인 제거 (| 포함한 라인)
    modified = modified:gsub("\n◇[^\n]*|[^\n]+", "")
    modified = modified:gsub("^◇[^\n]*|[^\n]+", "")
    
    -- 연속 빈 줄 정리
    modified = modified:gsub("\n\n\n+", "\n\n")
    modified = modified:gsub("%s+$", "")
    
    return modified
end

