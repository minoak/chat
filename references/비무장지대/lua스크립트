-- YYYY.MM.DD 형식의 날짜를 파싱하여 일수로 변환
function parseDate(dateStr)
    if not dateStr or dateStr == "" then
        return nil
    end

    local year, month, day = dateStr:match("(%d+)%.(%d+)%.(%d+)")
    if not year then
        return nil
    end

    year = tonumber(year)
    month = tonumber(month)
    day = tonumber(day)

    -- 간단한 일수 계산 (2000년 1월 1일 기준)
    local days = (year - 2000) * 365

    -- 월별 일수 (윤년 무시)
    local monthDays = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
    for i = 1, month - 1 do
        days = days + monthDays[i]
    end

    days = days + day

    return days
end

-- 두 날짜 간의 일수 차이 계산
function calculateDaysDiff(fromDate, toDate)
    local from = parseDate(fromDate)
    local to = parseDate(toDate)

    if not from or not to then
        return nil
    end

    return to - from
end

-- D-day 문자열 생성
function formatDday(days)
    if not days then
        return "D-???"
    end

    if days > 0 then
        return "D-" .. days
    elseif days == 0 then
        return "D-Day"
    else
        return "D+" .. math.abs(days)
    end
end

