-- ◇...◇ 이미지 힌트 추출
function extractImageHints(text)
    local hints = {}
    for hint in text:gmatch("◇([^◇]+)◇") do
        table.insert(hints, hint:match("^%s*(.-)%s*$"))  -- trim
    end
    return hints
end

-- ◇ ... 메타 라인 추출 (끝에 있는 단독 ◇)
function extractMetaLine(text)
    -- END 마커 먼저 제거
    local cleaned = text:gsub("<!%-%- ■END■ %-%->", "")
    -- 끝 공백/줄바꿈 제거 후 매칭
    local trimmed = cleaned:gsub("%s+$", "")
    local metaLine = trimmed:match("\n◇%s*([^\n]+)$") or trimmed:match("◇%s*([^\n]+)$")
    if metaLine and not metaLine:match("◇$") then
        return metaLine
    end
    return nil
end

-- 메타라인 직접 파싱 (보조모델 없이)
-- 형식: "2025.03.15, 17소초 1분대 생활관, 오후 | seyoung+10 seojin+5 ..."
function parseMetaLineDirect(triggerId, metaLine)
    if not metaLine then return end

    -- | 기준으로 분리
    local infoPart, affPart = metaLine:match("(.-)%s*|%s*(.*)")
    if not infoPart then
        infoPart = metaLine
        affPart = nil
    end

    -- 날짜, 장소, 시간 파싱 (쉼표로 구분)
    -- 형식: "2025.03.15, 17소초 1분대 생활관, 오후"
    local parts = {}
    for part in infoPart:gmatch("([^,]+)") do
        table.insert(parts, part:match("^%s*(.-)%s*$"))
    end

    if #parts >= 1 then
        -- 첫 번째가 날짜인지 확인 (YYYY.MM.DD 형식)
        local dateStr = parts[1]:match("(%d+%.%d+%.%d+)")
        if dateStr then
            setChatVar(triggerId, "current_date", dateStr)
        end
    end

    if #parts >= 2 then
        -- 두 번째는 장소
        setChatVar(triggerId, "current_location", parts[2])
    end

    if #parts >= 3 then
        -- 세 번째는 시간대 (오전, 오후, 저녁, 심야 등)
        local timeKeyword = parts[3]
        local timeMap = {
            ["새벽"] = "AM 05:00",
            ["아침"] = "AM 07:00",
            ["오전"] = "AM 09:00",
            ["주간"] = "AM 10:00",
            ["점심"] = "PM 12:00",
            ["오후"] = "PM 02:00",
            ["저녁"] = "PM 07:00",
            ["밤"] = "PM 10:00",
            ["전반야"] = "PM 11:00",
            ["후반야"] = "AM 02:00",
            ["심야"] = "AM 04:00"
        }
        local mappedTime = timeMap[timeKeyword] or timeKeyword
        setChatVar(triggerId, "current_time", mappedTime)
    end

    -- 호감도 파싱 (공백으로 구분된 "name+value" 또는 "name-value")
    if affPart then
        for entry in affPart:gmatch("(%S+)") do
            local name, sign, value = entry:match("(%a+)([%+%-])(%d+)")
            if name and sign and value then
                local changeNum = tonumber(sign .. value)
                local lowerName = name:lower()

                local isValid = false
                for _, char in ipairs(characters) do
                    if char == lowerName then
                        isValid = true
                        break
                    end
                end

                if isValid then
                    local currentScore = getState(triggerId, lowerName .. "_affection") or 0
                    local newScore = currentScore + changeNum
                    newScore = math.max(MIN_AFFECTION, math.min(MAX_AFFECTION, newScore))

                    setState(triggerId, lowerName .. "_affection", newScore)
                    setChatVar(triggerId, lowerName .. "_affection", tostring(newScore))
                end
            end
        end
    end
end

