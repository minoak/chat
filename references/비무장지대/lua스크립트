function callAuxiliaryModel(triggerId, prompt)
    if not USE_REAL_MODEL then
        return nil, "disabled"
    end
    
    if type(axLLM) ~= "function" then
        return nil, "axLLM not found"
    end
    
    local messages = {
        {
            role = "system",
            content = "You are an auxiliary processor. Follow instructions precisely. Output ONLY the requested tags, nothing else."
        },
        {
            role = "user",
            content = prompt
        }
    }
    
    local success, response = pcall(function()
        return axLLM(triggerId, messages)
    end)
    
    if success and response and response.success and response.result then
        return response.result, nil
    else
        local err = response and tostring(response.result) or "unknown error"
        return nil, err
    end
end

