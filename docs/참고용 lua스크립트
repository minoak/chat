local function buildLimitedChatLog(triggerId, log)
    local MAX_MESSAGES = 8 -- 프롬프트에 포함할 최대 메시지 개수 (이 값을 조절할 수 있습니다)
    
    local logLength = #log
    local startIndex = math.max(1, logLength - MAX_MESSAGES + 1)
    
    local logsToAdd = {}
    for i = startIndex, logLength do
        local message = log[i]
        if message and type(message.data) == "string" and message.data ~= "" then
            local original_content = message.data

            local cleaned_content = original_content:gsub("<%s*=[Ss][Aa][Vv][Ee]%|.-=%s*>", "")
                                                    :gsub("%s*<[Cc]hoice>.-</[Cc]hoice>%s*", "")

            local role = (message.role == "user" and "USER" or "CHARACTER")
            table.insert(logsToAdd, role .. ": " .. cleaned_content)
        end
    end
    
    print("Final chat log for prompt contains (up to) " .. MAX_MESSAGES .. " messages (savestrings & choice blocks removed).")
    return table.concat(logsToAdd, "\n\n")
end

