                    <strong>🎲 난이도: %s</strong>
                </div>
            </button>
			</body>]], btn_data, skill, description, tooltip1, tooltip2, difficultyLabel)
        
        return button_html
    end)
	
	d, r = d:gsub("<[cC]hoice>(.-)</[cC]hoice>", function(content)
        return '<div class="choice-container">' .. content .. '</div>'
    end)

    return c..d
end)

