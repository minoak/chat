-- 메인 로직 및 이벤트 리스너(마무리)
-- =============================================
function main(triggerId)
    updateCharacterPresence(triggerId)

    local function delay(ms)
        getTokens(triggerId, ""):await()
        print(string.format("Waited for a short interval."))
    end

    local mode = getState(triggerId, "statusPanel_Mode") or "2"
    if mode == "0" then return end

    local chatHistory = getFullChat(triggerId)
    if #chatHistory == 0 then return end
    local latestMessage = chatHistory[#chatHistory]
    local mainModelResponse = latestMessage.data

    if mainModelResponse then
        local difficulty_keyword = mainModelResponse:match("DC:%s*([%w%s]+)")
        if difficulty_keyword then
            local key = difficulty_keyword:match("^%s*(.-)%s*$"):lower()
            local range = difficultyRanges[key]
            if range then
                local random_dc = math.random(range.min, range.max)
                setState(triggerId, "diceRoll_RequiredValue", random_dc)
                setChatVar(triggerId, "cv_diceRoll_RequiredValue", random_dc)
                print(string.format("Difficulty keyword '%s' found. Generated random DC: %d (Range: %d-%d)", key, random_dc, range.min, range.max))
            else
                print("Warning: Found DC keyword '" .. key .. "' but it has no defined range.")
            end
        end
    end

    local choices_needed = mainModelResponse and mainModelResponse:match("Skill Check")
    
    local cleanedRP = mainModelResponse
        :gsub("%s*<[Tt]houghts>.-</[Tt]houghts>%s*\n?", "")
        :gsub("%s*<[Tt]ink>.-</[Tt]ink>%s*\n?", "")
        :gsub("<=[^=]*=>%s*\n?", "")
        :gsub("%s*{[^}]+}★■\n?", "")
        :gsub("%s*{[^|%}\n]+%|[^}\n]+}\n?", "")
        :gsub("%s*$", "")
        :gsub("%s*%<%-Owned Perks:.*%-%>%s*\n?", "")
        :gsub("(?m)^%s*%- System:[^\n]*\n?", "")

    if isFiefSystemActive(triggerId) and not getState(triggerId, "FiefSystemInitialized") then
        initializeFiefSystem(triggerId)
        setState(triggerId, "FiefSystemInitialized", true)
    end
    
    local tempChatHistory = getFullChat(triggerId)
    tempChatHistory[#chatHistory].data = cleanedRP
    local logStringForPrompts = buildLimitedChatLog(triggerId, tempChatHistory)
    local ChoicelogStringForPrompts = ChoicebuildLimitedChatLog(triggerId, tempChatHistory)		
    
    local status_prompt = makePrompt(triggerId, logStringForPrompts)
    local status_response = (mode == "1") and LLM(triggerId, status_prompt) or axLLM(triggerId, status_prompt)
    local status_data = ""
    if status_response.success and type(status_response.result) == "string" then
        status_data = status_response.result:gsub("```", ""):gsub("<[Tt]houghts>.-</[Tt]houghts>", "")
    else
        alertError(triggerId, "[StatusPanel] Failed to get LLM response for status: " .. tostring(status_response.result))
    end
    
    local tags_data = ""
    local isAffectionOn = (getState(triggerId, "Affection") or 0) == 1
    
    if isAffectionOn then
        print("Affection system is active. Generating tags...")
        delay(100)

        local tags_prompt = makeAffectionSkillPrompt(triggerId, logStringForPrompts)
        local tags_response = (mode == "1") and LLM(triggerId, tags_prompt) or axLLM(triggerId, tags_prompt)
        
        if tags_response.success and type(tags_response.result) == "string" then
            tags_data = tags_response.result:gsub("```", ""):gsub("<[Tt]houghts>.-</[Tt]houghts>", "")
        else
            alertError(triggerId, "[StatusPanel] Failed to get LLM response for tags: " .. tostring(tags_response.result))
        end
    else
        print("Affection system is off. Skipping separate tag generation LLM call.")
    end

    local choice_data = ""
    if choices_needed then
        delay(100)
        local choice_prompt = makeChoicePrompt(triggerId, ChoicelogStringForPrompts)
        local choice_response = (mode == "1") and LLM(triggerId, choice_prompt) or axLLM(triggerId, choice_prompt)
        if choice_response.success and type(choice_response.result) == "string" then
            choice_data = choice_response.result:gsub("```", ""):gsub("<[Tt]houghts>.-</[Tt]houghts>", "")
        else
            alertError(triggerId, "[StatusPanel] Failed to generate choices: " .. tostring(choice_response.result))
        end
    end
    
    setState(triggerId, "last_quest_type", nil)
    for _, statName in ipairs(stats) do setState(triggerId, statName .. "_change", 0) end
    for _, charName in ipairs(characters) do setState(triggerId, charName .. "affchange", 0) end

    setChatVar(triggerId, "cv_last_exp_reason", "")
    setChatVar(triggerId, "cv_exp_gained_this_turn", 0)	
    setChatVar(triggerId, "cv_last_exp_amount", 0)	

    if cleanedRP:match("%[Quest Succeed%]") then applyQuestCompletionRewards(triggerId) end
    processQuestDefinition(triggerId, cleanedRP)
    if isFiefSystemActive(triggerId) then
        processSystemTags(triggerId, cleanedRP)
        if cleanedRP:match("『Tax Collected』") then processTaxCollection(triggerId) end
        manageFiefModifiers(triggerId, cleanedRP)
    end
    
    processAffectionChangesInOutput(triggerId, tags_data)
    local exp_source_data = isAffectionOn and tags_data or status_data
    processCharacterExpChanges(triggerId, exp_source_data)
    
    local affectionMultiplier = getState(triggerId, "affectionMultiplier") or 1
    handleQuestResults(triggerId, affectionMultiplier)
    if isFiefSystemActive(triggerId) then
        applyModifierChanges(triggerId)
        updateFiefLimits(triggerId)
        applyBuildingChanges(triggerId)
        applyAllResourceChanges(triggerId)
    end
    applyQuestStateChanges(triggerId)

    -- ### ★★★ 수정된 부분 ★★★ ###
    -- 호감도 시스템이 켜져 있을 때만 점수 업데이트 및 표시 함수를 호출합니다.
    if isAffectionOn then
        updateAffectionScoreAndDisplay(triggerId)
    else
        print("Affection system is off. Skipping affection score updates.")
    end
    
    checkForLevelUp(triggerId)

    local newResourceBar = isFiefSystemActive(triggerId) and generateFiefStatusBar(triggerId) or ""
    
    local notificationBlock = ""
    if session_notifications_manager[triggerId] and #session_notifications_manager[triggerId] > 0 then
        notificationBlock = "\n" .. table.concat(session_notifications_manager[triggerId], "\n")
        session_notifications_manager[triggerId] = {}
    end

    local statusBlock = (newResourceBar ~= "" and newResourceBar .. "\n" or "") .. tags_data .. (status_data ~= "" and "\n" .. status_data or "") .. (choice_data ~= "" and "\n" .. choice_data or "")
    
    local perksDisplayString = generateOwnedPerksDisplayString(triggerId)
    local finalVisibleMessage = cleanedRP .. notificationBlock .. "\n\n\n" .. statusBlock .. (perksDisplayString ~= "" and "\n" .. perksDisplayString or "")

    local saveString = generateSaveString(triggerId)
    local finalMessageWithSaveData = finalVisibleMessage .. "\n" .. saveString
    setChat(triggerId, #chatHistory - 1, finalMessageWithSaveData)
    print("Final state saved into the current message.")

    if getState(triggerId, "temporary_state_delta") then
        setState(triggerId, "temporary_state_delta", nil)
        print("Temporary state delta has been cleared.")
    end
    
    syncAllChatVars(triggerId)
end

