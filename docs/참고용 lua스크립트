function applyAffCheat(triggerId, charName, changeAmount)
    local affKey = charName .. "aff"
    local currentAff = getState(triggerId, affKey) or 0
    local newAff = currentAff + changeAmount
    newAff = math.min(math.max(newAff, MIN_AFF), MAX_AFF)
    setState(triggerId, affKey, newAff)
    setChatVar(triggerId, "cv_" .. affKey, newAff)

    local lang = getState(triggerId, "Language") or 0
    local actionText
    if lang == 1 then
        actionText = changeAmount >= 0 and "만큼 증가하여" or "만큼 감소하여"
    else
        actionText = changeAmount >= 0 and "has increased by" or "has decreased by"
    end
    
    local message
    if lang == 1 then
        message = charName .. "의 호감도가 " .. math.abs(changeAmount) .. actionText .. " " .. newAff .. "이(가) 되었습니다."
    else
        message = "Affection of " .. charName .. " " .. actionText .. " " .. math.abs(changeAmount) .. " to " .. newAff .. "."
    end
    alertNormal(triggerId, message)

    recordTemporaryChange(triggerId, affKey, newAff)
end

function clampStatValue(value)
    return math.min(math.max(value, MIN_STAT), MAX_STAT)
end

function applyStatCheat(triggerId, statKey, changeAmount)
    local currentStat = getState(triggerId, statKey) or 0
    local newStat = clampStatValue(currentStat + changeAmount)
    setState(triggerId, statKey, newStat)
    setChatVar(triggerId, "cv_" .. statKey, newStat)
    
    local lang = getState(triggerId, "Language") or 0
    local statNameCapitalized = statKey:sub(1,1):upper() .. statKey:sub(2)

    local actionText
    if lang == 1 then
        actionText = changeAmount >= 0 and "만큼 증가하여" or "만큼 감소하여"
    else
        actionText = changeAmount >= 0 and "has increased by" or "has decreased by"
    end
    
    local message
    if lang == 1 then
        message = statNameCapitalized .. " 스탯이 " .. math.abs(changeAmount) .. actionText .. " " .. newStat .. "이(가) 되었습니다."
    else
        message = statNameCapitalized .. " stat " .. actionText .. " " .. math.abs(changeAmount) .. " to " .. newStat .. "."
    end
    alertNormal(triggerId, message)
    
    recordTemporaryChange(triggerId, statKey, newStat)
end


