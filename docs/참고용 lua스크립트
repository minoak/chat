-- 변경된 키를 추적하는 전역 테이블
local stateChangeTracker = {}

-- 상태 변경을 기록하는 함수 (기존 setState 래핑)
function setStateTracked(triggerId, key, value)
    setState(triggerId, key, value)
    
    -- 변경 추적
    if not stateChangeTracker[triggerId] then
        stateChangeTracker[triggerId] = {}
    end
    stateChangeTracker[triggerId][key] = true
end

-- 추적 초기화
function clearChangeTracker(triggerId)
    stateChangeTracker[triggerId] = nil
end

-- 변경된 키 목록 가져오기
function getChangedKeys(triggerId)
    return stateChangeTracker[triggerId] or {}
end

function batchSetStateTracked(triggerId, updates)
    if not stateChangeTracker[triggerId] then
        stateChangeTracker[triggerId] = {}
    end
    
    for key, value in pairs(updates) do
        setState(triggerId, key, value)
        stateChangeTracker[triggerId][key] = true
    end
end

function compareAndLogChanges(triggerId, beforeState)
    local changedKeys = getChangedKeys(triggerId)
    
    -- 변경 없으면 조기 종료
    local hasChanges = false
    for _ in pairs(changedKeys) do
        hasChanges = true
        break
    end
    
    if not hasChanges then
        print("--- [DEBUG] State Restored. No changes detected. ---")
        return
    end
    
    -- 변경된 키만 정렬
    local sortedKeys = {}
    for key in pairs(changedKeys) do
        table.insert(sortedKeys, key)
    end
    table.sort(sortedKeys)
    
    -- 로그 생성
    local logMessages = {}
    for _, key in ipairs(sortedKeys) do
        local beforeValue = beforeState[key]
        local afterValue = getState(triggerId, key)
        
        if beforeValue ~= afterValue then
            local beforeDisplay = (beforeValue == nil) and "nil" or tostring(beforeValue)
            local afterDisplay = (afterValue == nil) and "nil" or tostring(afterValue)
            
            table.insert(logMessages, string.format(
                "  - %-30s | FROM: %-10s | TO: %s", 
                key, beforeDisplay, afterDisplay
            ))
        end
    end
    
    if #logMessages > 0 then
        print("--- [DEBUG] State Restored with Changes ---")
        print(table.concat(logMessages, "\n"))
        print("-------------------------------------------")
    else
        print("--- [DEBUG] State Restored. No changes detected. ---")
    end
    
    -- 추적 초기화
    clearChangeTracker(triggerId)
end

-- 수정한 generateSaveString 함수
function generateSaveString(triggerId)
    -- 1. 각 시스템의 활성화 상태를 확인합니다.
    local isAffectionOn = (getState(triggerId, "Affection") or 0) == 1
    -- cv_Quest는 ChatVar이므로 문자열 "1"과 비교합니다.
    local isQuestOn = (getChatVar(triggerId, "cv_Quest") or "0") == "1"
    local isFiefOn = isFiefSystemActive(triggerId)
    local isRPGOn = (getState(triggerId, "RPG") or 0) == 1

    -- 2. 만약 모든 주요 시스템이 비활성화 상태이면, 빈 문자열을 반환하여 savestring을 생성하지 않습니다.
    if not isAffectionOn and not isQuestOn and not isFiefOn and not isRPGOn then
        print("--- All major systems are disabled. Skipping SaveString generation. ---")
        return ""
    end

    -- 3. 활성화 상태를 인자로 전달하여 데이터 수집 함수를 호출합니다.
    local stateTable = collectAllStateVariables(triggerId, isAffectionOn, isQuestOn, isFiefOn, isRPGOn)
    
    local parts = {}
    local sortedKeys = {}
    for k in pairs(stateTable) do table.insert(sortedKeys, k) end
    table.sort(sortedKeys)
    
    for _, key in ipairs(sortedKeys) do
        local value = stateTable[key]
        -- 이전 요청에서 적용한 키 뒤집기(난독화)는 그대로 유지합니다.
        table.insert(parts, string.reverse(key) .. ":" .. tostring(value))
    end
    
    return "<=SAVE|" .. table.concat(parts, "|") .. "=>"
end

function parseAndApplySaveString(triggerId, saveString)
    local start_marker = saveString:find("<=SAVE|", 1, true)
    if not start_marker then return false end
    
    local end_marker = saveString:find("=>", start_marker, true)
    if not end_marker then return false end
    
    local dataPart = saveString:sub(start_marker + 7, end_marker - 1)
    local len = #dataPart
    
    if len == 0 then return true end
    
    print("--- Applying State from Obfuscated SaveString ---")
    
    local stateUpdates = {}
    local updateCount = 0
    local pos = 1
    
    while pos <= len do
        local colonPos = dataPart:find(":", pos, true)
        if not colonPos then break end
        
        local pipePos = dataPart:find("|", colonPos, true)
        local endPos = pipePos or (len + 1)
        
        -- ### 수정된 부분 ###
        -- 뒤집힌 키를 추출한 후, 다시 뒤집어서 원래 키로 복원합니다.
        local reversedKey = dataPart:sub(pos, colonPos - 1)
        local key = string.reverse(reversedKey)
        
        local valueStr = dataPart:sub(colonPos + 1, endPos - 1)
        
        local finalValue
        local firstByte = valueStr:byte(1)
        
        if valueStr == "nil" then
            finalValue = nil
        elseif firstByte == 45 or (firstByte >= 48 and firstByte <= 57) then
            finalValue = tonumber(valueStr) or valueStr
        else
            finalValue = valueStr
        end
        
        stateUpdates[key] = finalValue
        updateCount = updateCount + 1
        pos = endPos + 1
    end
    
    batchSetStateTracked(triggerId, stateUpdates)
    
    print(string.format("--- State Apply Complete (%d updates) ---", updateCount))
    return true
end

function loadLatestStateFromHistory(triggerId)
    local startTime = os.clock()
    print("Attempting to load latest state from chat history (Optimized)...")
    
    -- ### ★★★★★ 수정된 부분 시작 ★★★★★ ###
    -- 1. "변경 전 상태"를 수집하기 전에, 먼저 각 시스템의 활성화 상태를 확인합니다.
    local isAffectionOn = (getState(triggerId, "Affection") or 0) == 1
    local isQuestOn = (getChatVar(triggerId, "cv_Quest") or "0") == "1"
    local isFiefOn = isFiefSystemActive(triggerId)
    local isRPGOn = (getState(triggerId, "RPG") or 0) == 1

    -- 2. 확인된 활성화 상태를 인자로 전달하여 "변경 전 상태"를 정확하게 수집합니다.
    local stateBeforeLoad = collectAllStateVariables(triggerId, isAffectionOn, isQuestOn, isFiefOn, isRPGOn)
    -- ### ★★★★★ 수정된 부분 끝 ★★★★★ ###
    
    local stateWasLoaded = false
    local chatLength = getChatLength(triggerId)

    for i = chatLength - 1, 0, -1 do
        local message = getChat(triggerId, i)
        
        if message and message.role == "char" and message.data then
            -- 이전 요청에서 적용한 키 뒤집기(난독화)를 고려하여 대소문자를 구분하지 않도록 수정합니다.
            local saveString = message.data:match("(<%=[Ss][Aa][Vv][Ee]%|.-%=>)")
            if saveString then
                print("Found SaveString at chat index: " .. i)
                parseAndApplySaveString(triggerId, saveString)
                stateWasLoaded = true
                break 
            end
        end
    end
    
    if not stateWasLoaded then
        print("No SaveString found in history. Using current state.")
    end

    local tempDelta = getState(triggerId, "temporary_state_delta")
    if tempDelta and tempDelta.sourceIndex ~= nil and tempDelta.data then
        local sourceIndex = tempDelta.sourceIndex
        local currentLastIndex = getChatLength(triggerId) - 1
        
        print(string.format("Index Check: Source Index=%d, Current Last Index=%d", sourceIndex, currentLastIndex))

        if currentLastIndex == sourceIndex + 1 then
            print("Index match confirmed. Applying temporary state changes (deltas)...")
            for key, value in pairs(tempDelta.data) do
                setState(triggerId, key, value)
                print("  - Applied delta: " .. key .. " = " .. tostring(value))
            end
        else
            print("Index mismatch. Discarding stale temporary changes.")
        end
    end

    compareAndLogChanges(triggerId, stateBeforeLoad)
    syncAllChatVars(triggerId)
end

