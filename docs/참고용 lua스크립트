function collectAllStateVariables(triggerId, isAffectionOn, isQuestOn, isFiefOn, isRPGOn)
    local stateData = {}

    -- 1. 캐릭터 레벨 및 스킬 시스템 변수 (RPG 시스템이 켜져 있을 때만 저장)
    if isRPGOn then
        print("Collecting RPG System state...")
        stateData["Character_Level"] = getState(triggerId, "Character_Level") or 1
        stateData["Character_EXP"] = getState(triggerId, "Character_EXP") or 0
        stateData["Skill_Points_Available"] = getState(triggerId, "Skill_Points_Available") or 0
        stateData["Perk_Points_Available"] = getState(triggerId, "Perk_Points_Available") or 0
        
        for perkId, _ in pairs(perks) do
            stateData["Perk_" .. perkId .. "_acquired"] = getState(triggerId, "Perk_" .. perkId .. "_acquired") or 0
        end

        for _, skillName in ipairs(skills) do
            local keyName = skillName:gsub(" ", "_")
            stateData[keyName .. "_points"] = getState(triggerId, keyName .. "_points") or 0
            stateData[keyName .. "_bonus"] = getState(triggerId, keyName .. "_bonus") or -1
        end
    end

    -- 2. 호감도 변수 (호감도 시스템이 켜져 있을 때만 저장)
    if isAffectionOn then
        print("Collecting Affection state...")
        for _, name in ipairs(characters) do
            stateData[name .. "aff"] = getState(triggerId, name .. "aff") or 0
        end
    end

    -- 3. 퀘스트 스탯 및 정보 변수 (퀘스트 UI가 켜져 있을 때만 저장)
    if isQuestOn then
        print("Collecting Quest/Stat state...")
        for _, statName in ipairs(stats) do
            stateData[statName] = getState(triggerId, statName) or 0
        end
        stateData["current_quest_difficulty"] = getState(triggerId, "current_quest_difficulty") or "nil"
        stateData["current_quest_type"] = getState(triggerId, "current_quest_type") or "nil"
        stateData["current_quest_giver"] = getState(triggerId, "current_quest_giver") or "nil"
    end
    
    -- 4. 영지 시스템 변수 (영지 시스템(DLC2)이 켜져 있을 때만 저장)
    if isFiefOn then
        print("Collecting Fief System state...")
        for _, name in ipairs(fiefResourceNames) do
            stateData["Fief_" .. name] = getState(triggerId, "Fief_" .. name) or 0
            stateData["Fief_" .. name .. "_Max"] = getState(triggerId, "Fief_" .. name .. "_Max") or 0
        end
        for name, data in pairs(fiefBuildings) do
            stateData[data.stateVar] = getState(triggerId, data.stateVar) or 0
        end
        for id, data in pairs(fiefModifiers) do
            stateData["Fief_Modifier_" .. id] = getState(triggerId, "Fief_Modifier_" .. id) or 0
        end
        for charName, unlockData in pairs(specialBuildingUnlocks) do
            stateData["Fief_" .. unlockData.varName] = getState(triggerId, "Fief_" .. unlockData.varName) or 0
        end
        stateData["Toggle_TaxRelief"] = getState(triggerId, "Toggle_TaxRelief") or 0
        stateData["Toggle_HaltInflux"] = getState(triggerId, "Toggle_HaltInflux") or 0
    end
    
    -- 5. 메인 퀘스트 완료 여부 (항상 저장)
    -- 이 정보는 스토리 진행의 핵심이므로 시스템 on/off와 무관하게 유지합니다.
    local questCompletionFlags = {
        "MainquestComplete1", "MainquestComplete2", "MainquestComplete3",
        "DLCquestComplete1", "DLCquestComplete2", "DLCquestComplete3",
        "FiefquestComplete1", "FiefquestComplete2", "FiefquestComplete3"
    }
    for _, flag in ipairs(questCompletionFlags) do
        stateData[flag] = getState(triggerId, flag) or 0
    end

    return stateData
end

