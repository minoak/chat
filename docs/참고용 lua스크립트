function initializeFiefSystem(triggerId)
    for _, name in ipairs(fiefResourceNames) do
        if getState(triggerId, "Fief_" .. name) == nil then
            setState(triggerId, "Fief_" .. name, fiefInitialValues[name] or 0)
        end
        if getState(triggerId, "Fief_" .. name .. "_Max") == nil then
             setState(triggerId, "Fief_" .. name .. "_Max", fiefInitialValues[name.. "_Max"] or 100)
        end
    end	
    
    for name, data in pairs(fiefBuildings) do
        if getState(triggerId, data.stateVar) == nil then
            if fiefInitialValues[data.id] ~= nil then
                setState(triggerId, data.stateVar, fiefInitialValues[data.id])
            else
                setState(triggerId, data.stateVar, 0)
            end
        end
    end

    if getState(triggerId, "Toggle_TaxRelief") == nil then
        setState(triggerId, "Toggle_TaxRelief", 0)
    end

    if getState(triggerId, "Toggle_HaltInflux") == nil then
        setState(triggerId, "Toggle_HaltInflux", 0)
    end
end

function processSystemTags(triggerId, text)
    for _, data in pairs(fiefBuildings) do
        setState(triggerId, data.stateVar .. "_change", 0)
    end
    for _, name in ipairs(fiefResourceNames) do
        setState(triggerId, "Fief_" .. name .. "_event_change", 0)
    end
    
    for id, _ in pairs(fiefModifiers) do
        setState(triggerId, "Fief_Modifier_" .. id .. "_change", 0)
    end

    for content in text:gmatch("『([^』]+)』") do
        for pair in content:gmatch("([^|]+)") do
            local name, changeStr = pair:match("([^:]+):%s*([%+%-]?%d+)")
            
            if name and changeStr then
                name = name:match("^%s*(.-)%s*$")
                local changeAmount = tonumber(changeStr)
                local normalizedName = name:lower():gsub("[^%w]", "")
                
                local isProcessed = false
                -- 자원 변경 처리
                for _, resName in ipairs(fiefResourceNames) do
                    if resName:lower() == name:lower() then
                        local currentChange = getState(triggerId, "Fief_" .. resName .. "_event_change") or 0
                        setState(triggerId, "Fief_" .. resName .. "_event_change", currentChange + changeAmount)
                        isProcessed = true
                        break
                    end
                end
                
                -- 건물 변경 처리
                if not isProcessed then
                    for key, data in pairs(fiefBuildings) do
                        local normalizedKey = key:lower():gsub("[^%w]", "")
                        if normalizedKey == normalizedName then
                            local currentChange = getState(triggerId, data.stateVar .. "_change") or 0
                            setState(triggerId, data.stateVar .. "_change", currentChange + changeAmount)
                            break
                        end
                    end
                end
            end
        end
    end
end

function applyBuildingChanges(triggerId)
    print("==========================================================")
    print("[DEBUG] Running applyBuildingChanges (Simplified)...")
    
    -- 현재 병력 수 계산
    local currentTroopCount = 0
    for name, data in pairs(fiefBuildings) do
        if data.tags and table.concat(data.tags):find("Troop") then
            currentTroopCount = currentTroopCount + (getState(triggerId, data.stateVar) or 0)
        end
    end

    -- 1단계: 모든 음수 변경사항(해체, 파괴) 먼저 적용
    print("--- Pass 1: Processing Disbands & Demolitions ---")
    for name, data in pairs(fiefBuildings) do
        local change = getState(triggerId, data.stateVar .. "_change") or 0
        if change < 0 then
            local currentValue = getState(triggerId, data.stateVar) or 0
            local newValue = math.max(0, currentValue + change)
            setState(triggerId, data.stateVar, newValue)
            
            -- 해체된 병력만큼 현재 병력 수에서 차감
            if data.tags and table.concat(data.tags):find("Troop") then
                currentTroopCount = currentTroopCount + change -- change가 음수이므로 실질적으로 차감
            end
            
            print(string.format("  - DISBAND/DEMOLISH: %-20s | Change: %-3d | New Count: %d", name, change, newValue))
        end
    end

    -- 2단계: 모든 양수 변경사항(건설, 모집) 적용
    print("--- Pass 2: Processing Construction & Recruitment ---")
    for name, data in pairs(fiefBuildings) do
        local originalChange = getState(triggerId, data.stateVar .. "_change") or 0
        if originalChange > 0 then
            local change = originalChange
            local currentValue = getState(triggerId, data.stateVar) or 0
            
            print(string.format("\n  -> Processing: %s (Requested: +%d, Current: %d)", name, change, currentValue))

            -- 병력 한도 검사
            if data.tags and table.concat(data.tags):find("Troop") then
                local troopLimit = 4
                local remainingSlots = troopLimit - currentTroopCount
                print(string.format("     - TROOP LIMIT CHECK | Limit: %d | Current: %d | Remaining: %d", troopLimit, currentTroopCount, remainingSlots))

                if remainingSlots <= 0 then
                    change = 0
                    print("     - RESULT: No slots available. Change = 0")
                elseif change > remainingSlots then
                    change = remainingSlots
                    print(string.format("     - RESULT: Limited to %d slots", change))
                end
                currentTroopCount = currentTroopCount + change
            end

            -- 건물 한도 검사
            if data.limit then
                local remainingLimit = data.limit - currentValue
                print(string.format("     - BUILDING LIMIT CHECK | Limit: %d | Current: %d | Remaining: %d", data.limit, currentValue, remainingLimit))
                
                if remainingLimit <= 0 then
                    change = 0
                    print("     - RESULT: Building limit reached. Change = 0")
                elseif change > remainingLimit then
                    change = remainingLimit
                    print(string.format("     - RESULT: Limited to %d buildings", change))
                end
            end
            
            local newValue = currentValue + change
            setState(triggerId, data.stateVar, newValue)
            print(string.format("  ==> FINAL: %s | Applied Change: +%d | New Total: %d", name, change, newValue))
        end
    end
    print("==========================================================")
end

function applyModifierChanges(triggerId)
    for id, data in pairs(fiefModifiers) do
        local change = getState(triggerId, "Fief_Modifier_" .. id .. "_change") or 0
        local currentValue = getState(triggerId, "Fief_Modifier_" .. id) or 0
        
        local newValue = currentValue
        if change == 1 then
            newValue = 1
        elseif change == -1 then
            newValue = 0
        end
        
        if newValue ~= currentValue then
             print("[DEBUG] Setting modifier '" .. id .. "' from " .. currentValue .. " to " .. newValue)
        end

        setState(triggerId, "Fief_Modifier_" .. id, newValue)
        setChatVar(triggerId, "cv_Modifier_" .. id, newValue)
    end
end

function applySpecialEffects(triggerId)
    local changes = {}
    changes.Population = 0
    
    if (getState(triggerId, "Toggle_HaltInflux") or 0) == 0 then
        print("Population influx is active. Calculating growth from buildings.")
        
        if (getState(triggerId, fiefBuildings["Scribe Office"].stateVar) or 0) > 0 then
            local numScribeOffices = getState(triggerId, fiefBuildings["Scribe Office"].stateVar)
            changes.Population = changes.Population + math.random(numScribeOffices * 20, numScribeOffices * 32)
        end

        if (getState(triggerId, fiefBuildings["Elsie's Infirmary"].stateVar) or 0) > 0 then
            changes.Population = changes.Population + math.random(12, 24)
        end

        if (getState(triggerId, fiefBuildings["Amelia's Church"].stateVar) or 0) > 0 then
            changes.Population = changes.Population + math.random(12, 24)
        end
    else
        print("Population growth from all buildings halted by policy.")
    end

    -- 인구 성장 보너스 적용
    local total_pop_growth_modifier = 0
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.effects and data.effects.population_growth_modifier then
                total_pop_growth_modifier = total_pop_growth_modifier + data.effects.population_growth_modifier
            end
        end
    end
    
    if changes.Population > 0 then
        changes.Population = math.floor(changes.Population * (1 + total_pop_growth_modifier / 100))
    end

    if (getState(triggerId, "Toggle_TaxRelief") or 0) == 1 then
        if changes.Population > 0 then
            changes.Population = math.floor(changes.Population * 1.5)
            print("Tax Relief policy active: +50% population growth.")
        end
    end
    
    if changes.Population < 0 then changes.Population = 0 end
    return changes
end

function processTaxCollection(triggerId)
    -- 생산량 보너스 계산
    local total_effects = { gold_income_modifier = 0, material_income_modifier = 0 }
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.effects and data.effects.gold_income_modifier then
                total_effects.gold_income_modifier = total_effects.gold_income_modifier + data.effects.gold_income_modifier
            end
            if data.effects and data.effects.material_income_modifier then
                total_effects.material_income_modifier = total_effects.material_income_modifier + data.effects.material_income_modifier
            end
        end
    end

    -- 치트 값 가져오기
    local cheatMaterialBonus = getState(triggerId, "Cheat_Material_Bonus") or 0
    local cheatMaterialFlat = getState(triggerId, "Cheat_Material_Flat") or 0
    local cheatGoldBonus = getState(triggerId, "Cheat_Gold_Bonus") or 0
    local cheatGoldFlat = getState(triggerId, "Cheat_Gold_Flat") or 0

    -- 기본 생산량과 유지비 계산
    local final_prod = { Material = 0, Gold = 0, Favor = 0, Support = 0 }
    local maintenance = { Material = 0, Gold = 0, Favor = 0, Support = 0 }
    
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 then
            if data.base_production then
                for res, val in pairs(data.base_production) do
                    if final_prod[res] ~= nil then 
                        final_prod[res] = final_prod[res] + (val * count) 
                    end
                end
            end
            if data.maintenance then
                for res, val in pairs(data.maintenance) do
                    if maintenance[res] ~= nil then 
                        maintenance[res] = maintenance[res] + (val * count) 
                    end
                end
            end
        end
    end

    -- 생산량 보너스 적용
    local resource_bonus_percent = { Material = 0, Gold = 0 }
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 and data.production_bonus then
            for res, bonus in pairs(data.production_bonus) do
                if resource_bonus_percent[res] ~= nil then
                    resource_bonus_percent[res] = resource_bonus_percent[res] + (bonus * count)
                end
            end
        end
    end

    resource_bonus_percent.Material = resource_bonus_percent.Material + cheatMaterialBonus
    resource_bonus_percent.Gold = resource_bonus_percent.Gold + cheatGoldBonus

    final_prod.Material = math.floor(final_prod.Material * (1 + resource_bonus_percent.Material / 100))
    final_prod.Gold = math.floor(final_prod.Gold * (1 + resource_bonus_percent.Gold / 100))
    
    -- 식량 부족 체크
    local foodProd = getChatVar(triggerId, "cv_Fief_Food_Production") or 0
    local foodCons = getChatVar(triggerId, "cv_Fief_Food_Consumption") or 0
    local food_deficit = foodCons - foodProd

    local special_changes = {}
    if food_deficit > 0 then
        special_changes.Population = 0
        print("Food deficit! Building-based population growth is halted.")
        
        local outflow = math.random(5, 15) + math.floor(food_deficit / 10)
        special_changes.Population = special_changes.Population - math.min(outflow, 30)
        print("Population outflow due to food deficit: " .. special_changes.Population)
    else
        special_changes = applySpecialEffects(triggerId)
    end
    
    -- 인구 성장 고정값 추가
    local total_pop_growth_flat = 0
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.effects and data.effects.population_growth_flat then
                total_pop_growth_flat = total_pop_growth_flat + data.effects.population_growth_flat
            end
        end
    end

    -- 세금 계산
    local population = getState(triggerId, "Fief_Population") or 0
    local currentSupport = getState(triggerId, "Fief_Support") or 0
    local taxModifier = 1.0 
    
    if currentSupport < 25 then taxModifier = 0.5
    elseif currentSupport < 50 then taxModifier = 0.75 end
    
    local taxIncome = math.floor((population * 0.1) * taxModifier) 
    final_prod.Gold = final_prod.Gold + taxIncome

    -- 모디파이어 효과 적용
    final_prod.Gold = math.floor(final_prod.Gold * (1 + total_effects.gold_income_modifier / 100))
    final_prod.Material = math.floor(final_prod.Material * (1 + total_effects.material_income_modifier / 100))

    -- 치트 고정값 추가
    final_prod.Material = final_prod.Material + cheatMaterialFlat
    final_prod.Gold = final_prod.Gold + cheatGoldFlat

    -- 자원 변경분 계산 및 적용
    local resourcesToUpdate = {"Material", "Gold", "Population", "Favor", "Support"}
    for _, resName in ipairs(resourcesToUpdate) do
        local prod_change = 0
        local maint_cost = 0
        local special_change = 0
        
        if resName == "Population" then
            special_change = (special_changes.Population or 0) + total_pop_growth_flat
        else
            prod_change = final_prod[resName] or 0
            maint_cost = maintenance[resName] or 0
        end

        local totalChange = prod_change - maint_cost + special_change
        
        if resName == "Support" then
            local supportDecay = 15
            totalChange = totalChange - supportDecay
            print("Weekly support decay applied: -" .. supportDecay)
        end
        
        local currentEventChange = getState(triggerId, "Fief_" .. resName .. "_event_change") or 0
        setState(triggerId, "Fief_" .. resName .. "_event_change", currentEventChange + totalChange)
    end
    
    -- 일회성 모디파이어 제거
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 and not data.permanent then
            setState(triggerId, "Fief_Modifier_" .. id .. "_change", -1)
        end
    end
end

function updateFiefCycle_perTurn(triggerId)
    local total_effects_food = { food_production_modifier = 0, food_production_flat = 0 }
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.effects and data.effects.food_production_modifier then
                total_effects_food.food_production_modifier = total_effects_food.food_production_modifier + data.effects.food_production_modifier
            end
            if data.effects and data.effects.food_production_flat then
                total_effects_food.food_production_flat = total_effects_food.food_production_flat + data.effects.food_production_flat
            end
        end
    end

    local cheatFoodBonus = getState(triggerId, "Cheat_Food_Bonus") or 0
    local cheatFoodFlat = getState(triggerId, "Cheat_Food_Flat") or 0

    local final_prod_food = 0
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 and data.base_production and data.base_production.Food then
            final_prod_food = final_prod_food + (data.base_production.Food * count)
        end
    end
	
    local food_bonus_percent = 0
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 and data.production_bonus and data.production_bonus.Food then
            food_bonus_percent = food_bonus_percent + (data.production_bonus.Food * count)
        end
    end
    
    food_bonus_percent = food_bonus_percent + cheatFoodBonus
    
    local totalFoodProduction = math.floor(final_prod_food * (1 + food_bonus_percent / 100))
    totalFoodProduction = math.floor(totalFoodProduction * (1 + total_effects_food.food_production_modifier / 100))
    totalFoodProduction = totalFoodProduction + total_effects_food.food_production_flat
	
    totalFoodProduction = totalFoodProduction + cheatFoodFlat

    if totalFoodProduction < 0 then totalFoodProduction = 0 end

    local maintenance_food = 0
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 and data.maintenance and data.maintenance.Food then
            maintenance_food = maintenance_food + (data.maintenance.Food * count)
        end
    end
    local current_population = getState(triggerId, "Fief_Population") or 0
    local totalFoodConsumption = current_population + maintenance_food

    setChatVar(triggerId, "cv_Fief_Food_Production", totalFoodProduction)
    setChatVar(triggerId, "cv_Fief_Food_Consumption", totalFoodConsumption)
end

function applyAllResourceChanges(triggerId)
    print("--- Applying all resource and population changes ---")
    local resourcesToUpdate = {"Material", "Gold", "Population", "Power", "Favor", "Support"}
    
    for _, resName in ipairs(resourcesToUpdate) do
        local currentValue = getState(triggerId, "Fief_" .. resName) or 0
        local event_change = getState(triggerId, "Fief_" .. resName .. "_event_change") or 0
        
        local newValue = currentValue + event_change
        
        -- 한도 적용
        local max_val = getState(triggerId, "Fief_" .. resName .. "_Max") or 0
        if resName ~= "Power" then
             if newValue > max_val then newValue = max_val end
        end
        if newValue < 0 then newValue = 0 end
        
        if resName == "Power" then
            local maxPower = getState(triggerId, "Fief_Power_Max") or 0
            if newValue > maxPower then newValue = maxPower end
        end

        setState(triggerId, "Fief_" .. resName, newValue)
        print(string.format("  - %s: %s + %s = %s", resName, tostring(currentValue), tostring(event_change), tostring(newValue)))
    end
end

function updateFiefLimits(triggerId)
    local totalPopLimit = fiefInitialValues.Population_Max or 100
    for name, data in pairs(fiefBuildings) do
        if data.population_limit then
            local count = getState(triggerId, data.stateVar) or 0
            totalPopLimit = totalPopLimit + (count * data.population_limit)
        end
    end
    setState(triggerId, "Fief_Population_Max", totalPopLimit)

    local resourceLimits = { Material = 0, Gold = 0 }
    for resName, _ in pairs(resourceLimits) do

        local newMax = fiefInitialValues[resName .. "_Max"] or 0
        

        for _, buildingData in pairs(fiefBuildings) do
            if buildingData.max_storage and buildingData.max_storage[resName] then
                local count = getState(triggerId, buildingData.stateVar) or 0
                if count > 0 then
                    newMax = newMax + (buildingData.max_storage[resName] * count)
                end
            end
        end
        setState(triggerId, "Fief_" .. resName .. "_Max", newMax)		
    end

    local totalPowerLimit = fiefInitialValues.Power_Max or 10
    
    for _, data in pairs(fiefBuildings) do
        if data.power_limit then
            local count = getState(triggerId, data.stateVar) or 0
            totalPowerLimit = totalPowerLimit + (count * data.power_limit)
        end
    end
    
    local total_power_max_modifier = 0
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.effects and data.effects.power_max_flat then
                total_power_max_modifier = total_power_max_modifier + data.effects.power_max_flat
            end
        end
    end
    totalPowerLimit = totalPowerLimit + total_power_max_modifier
    
    setState(triggerId, "Fief_Power_Max", totalPowerLimit)	
end

function checkSpecialBuildingUnlocks(triggerId)
    for charName, unlockData in pairs(specialBuildingUnlocks) do
        if (getState(triggerId, "Fief_" .. unlockData.varName) or 0) == 0 then
            local currentAff = getState(triggerId, charName .. "aff") or 0
            
            if currentAff >= unlockData.threshold then
                setState(triggerId, "Fief_" .. unlockData.varName, 1)
                setChatVar(triggerId, "cv_" .. unlockData.varName, 1)
            end
        end
    end
end

function manageFiefModifiers(triggerId, text)
    for id, data in pairs(fiefModifiers) do
        if text:find(data.keyword, 1, true) then
            setState(triggerId, "Fief_Modifier_" .. id .. "_change", 1)
        end
    end

    for removed_keyword_text in text:gmatch("<-Modifier Removed%|(.-)%->") do
        removed_keyword_text = removed_keyword_text:match("^%s*(.-)%s*$"):lower()
        local found_id = nil
        for id, data in pairs(fiefModifiers) do
            local keyword_from_table = data.keyword:gsub("<%-", ""):gsub("%->", ""):lower()
            if keyword_from_table == removed_keyword_text then
                found_id = id
                break
            end
        end
        if found_id then
            setState(triggerId, "Fief_Modifier_" .. found_id .. "_change", -1)
        end
    end
end

