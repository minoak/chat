function Execute_Supply(triggerId)
    local currentGold = getState(triggerId, "Fief_Gold") or 0
    local cost = 50
    local lang = getState(triggerId, "Language") or 0

    if currentGold < cost then
        local errorMessage = (lang == 1) and
            ("금화가 부족합니다. 보급품을 구매하려면 금화 50이 필요합니다. (현재: " .. currentGold .. ")") or
            ("Not enough gold. 50 gold is required to purchase supplies. (Current: " .. currentGold .. ")")
        alertError(triggerId, errorMessage)
        return
    end

    local newGold = currentGold - cost
    setState(triggerId, "Fief_Gold", newGold)

    local maxSupply = MAX_STAT 
    setState(triggerId, "supply", maxSupply)

    setChatVar(triggerId, "cv_Fief_Gold", newGold)
    setChatVar(triggerId, "cv_supply", tostring(maxSupply))
    
    local successMessage = (lang == 1) and
        ("금화 50을 사용하여 보급품을 최대로 채웠습니다. Supply 스탯이 " .. maxSupply .. "가 되었습니다.") or
        ("Used 50 gold to fully stock supplies. Supply stat is now " .. maxSupply .. ".")
    alertNormal(triggerId, successMessage)
    
    recordTemporaryChange(triggerId, "Fieg_Gold", newGold)
    recordTemporaryChange(triggerId, "supply", maxSupply)
end

