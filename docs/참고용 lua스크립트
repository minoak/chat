function generateFiefStatusBar(triggerId)
    local parts = {}
    table.insert(parts, "Fief Status")
    
    local material = getState(triggerId, "Fief_Material") or 0
    local materialMax = getState(triggerId, "Fief_Material_Max") or 0
    table.insert(parts, string.format("Material: %d/%d", material, materialMax))
    
    local gold = getState(triggerId, "Fief_Gold") or 0
    local goldMax = getState(triggerId, "Fief_Gold_Max") or 0
    table.insert(parts, string.format("Gold: %d/%d", gold, goldMax))
    
    local favor = getState(triggerId, "Fief_Favor") or 0
    local favorMax = getState(triggerId, "Fief_Favor_Max") or 100
    table.insert(parts, string.format("Favor: %d/%d", favor, favorMax))

    local support = getState(triggerId, "Fief_Support") or 0
    local supportMax = getState(triggerId, "Fief_Support_Max") or 100
    table.insert(parts, string.format("Support: %d/%d", support, supportMax))
    
    local power = getState(triggerId, "Fief_Power") or 0
    local powerMax = getState(triggerId, "Fief_Power_Max") or 0
    table.insert(parts, string.format("Power: %d/%d", power, powerMax))
    
    local population = getState(triggerId, "Fief_Population") or 0
    local populationMax = getState(triggerId, "Fief_Population_Max") or 0
    table.insert(parts, string.format("Population: %d/%d", population, populationMax))
    
    return "<=" .. table.concat(parts, "|") .. "=>"
end

function syncFiefChatVars(triggerId)
    -- 자원 동기화
    for _, name in ipairs(fiefResourceNames) do
        setChatVar(triggerId, "cv_Fief_" .. name, getState(triggerId, "Fief_" .. name))
        setChatVar(triggerId, "cv_Fief_" .. name .. "_Max", getState(triggerId, "Fief_" .. name .. "_Max"))
    end

    -- 병력 수 계산 (현재 상태 기준)
    local totalTroopCount = 0
    for name, data in pairs(fiefBuildings) do
        if data.tags and table.concat(data.tags):find("Troop") then
            totalTroopCount = totalTroopCount + (getState(triggerId, data.stateVar) or 0)
        end
    end
    setChatVar(triggerId, "cv_Total_Troops", totalTroopCount)

    -- 건물 수 동기화
    for name, data in pairs(fiefBuildings) do
        local current_val = getState(triggerId, data.stateVar) or 0
        if data.id then
            setChatVar(triggerId, "cv_" .. data.id, current_val)
        else
            setChatVar(triggerId, "cv_" .. name, current_val)
        end
    end

    -- ### 순 생산량 계산 로직 ###
    local cheatMaterialBonus = getState(triggerId, "Cheat_Material_Bonus") or 0
    local cheatMaterialFlat = getState(triggerId, "Cheat_Material_Flat") or 0
    local cheatGoldBonus = getState(triggerId, "Cheat_Gold_Bonus") or 0
    local cheatGoldFlat = getState(triggerId, "Cheat_Gold_Flat") or 0

    local total_effects_prod = { gold_income_modifier = 0, material_income_modifier = 0 }
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.effects and data.effects.gold_income_modifier then 
                total_effects_prod.gold_income_modifier = total_effects_prod.gold_income_modifier + data.effects.gold_income_modifier 
            end
            if data.effects and data.effects.material_income_modifier then 
                total_effects_prod.material_income_modifier = total_effects_prod.material_income_modifier + data.effects.material_income_modifier 
            end
        end
    end
    
    local final_prod = { Material = 0, Gold = 0, Favor = 0, Support = 0 }
    local maintenance = { Material = 0, Gold = 0, Favor = 0, Support = 0 }
    
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 then
            if data.base_production then
                for res, val in pairs(data.base_production) do
                    if final_prod[res] ~= nil then final_prod[res] = final_prod[res] + (val * count) end
                end
            end
            if data.maintenance then
                for res, val in pairs(data.maintenance) do
                    if maintenance[res] ~= nil then maintenance[res] = maintenance[res] + (val * count) end
                end
            end
        end
    end
    
    local resource_bonus_percent = { Material = 0, Gold = 0 }
    for name, data in pairs(fiefBuildings) do
        local count = getState(triggerId, data.stateVar) or 0
        if count > 0 and data.production_bonus then
            for res, bonus in pairs(data.production_bonus) do
                if resource_bonus_percent[res] ~= nil then 
                    resource_bonus_percent[res] = resource_bonus_percent[res] + (bonus * count) 
                end
            end
        end
    end

    resource_bonus_percent.Material = resource_bonus_percent.Material + cheatMaterialBonus
    resource_bonus_percent.Gold = resource_bonus_percent.Gold + cheatGoldBonus

    final_prod.Material = math.floor(final_prod.Material * (1 + resource_bonus_percent.Material / 100))
    final_prod.Gold = math.floor(final_prod.Gold * (1 + resource_bonus_percent.Gold / 100))
    
    local population = getState(triggerId, "Fief_Population") or 0
    local currentSupport = getState(triggerId, "Fief_Support") or 0
    local taxModifier = 1.0
    if currentSupport < 25 then taxModifier = 0.5
    elseif currentSupport < 50 then taxModifier = 0.75 end
    
    if (getState(triggerId, "Toggle_TaxRelief") or 0) == 1 then
        taxModifier = taxModifier * 0.75
    end

    local taxIncome = math.floor((population * 0.1) * taxModifier)

    final_prod.Gold = final_prod.Gold + taxIncome
    final_prod.Gold = math.floor(final_prod.Gold * (1 + total_effects_prod.gold_income_modifier / 100))
    final_prod.Material = math.floor(final_prod.Material * (1 + total_effects_prod.material_income_modifier / 100))
    
    final_prod.Material = final_prod.Material + cheatMaterialFlat
    final_prod.Gold = final_prod.Gold + cheatGoldFlat

    setChatVar(triggerId, "cv_Fief_Net_Material", final_prod.Material - (maintenance.Material or 0))
    setChatVar(triggerId, "cv_Fief_Net_Gold", final_prod.Gold - (maintenance.Gold or 0))
    setChatVar(triggerId, "cv_Fief_Net_Favor", final_prod.Favor - (maintenance.Favor or 0))	
    setChatVar(triggerId, "cv_Fief_Net_Support", final_prod.Support - (maintenance.Support or 0))

    -- 인구 증감 예상치 계산
    local foodProd = getChatVar(triggerId, "cv_Fief_Food_Production") or 0
    local foodCons = getChatVar(triggerId, "cv_Fief_Food_Consumption") or 0
    local food_deficit = foodCons - foodProd

    if food_deficit > 0 then
        local minOutflow = 5 + math.floor(food_deficit / 10)
        local maxOutflow = 15 + math.floor(food_deficit / 10)
        minOutflow = math.min(minOutflow, 30)
        maxOutflow = math.min(maxOutflow, 30)
        
        setChatVar(triggerId, "cv_Fief_Pop_Increase_Min", -maxOutflow)
        setChatVar(triggerId, "cv_Fief_Pop_Increase_Max", -minOutflow)
    else
        local minPopIncrease, maxPopIncrease = 0, 0
        
        if (getState(triggerId, "Toggle_HaltInflux") or 0) == 0 then
            if (getState(triggerId, fiefBuildings["Scribe Office"].stateVar) or 0) > 0 then
                local numScribeOffices = getState(triggerId, fiefBuildings["Scribe Office"].stateVar)
                minPopIncrease = minPopIncrease + (numScribeOffices * 20)
                maxPopIncrease = maxPopIncrease + (numScribeOffices * 32)
            end
            if (getState(triggerId, fiefBuildings["Elsie's Infirmary"].stateVar) or 0) > 0 then
                minPopIncrease = minPopIncrease + 12
                maxPopIncrease = maxPopIncrease + 24
            end
            if (getState(triggerId, fiefBuildings["Amelia's Church"].stateVar) or 0) > 0 then
                minPopIncrease = minPopIncrease + 12
                maxPopIncrease = maxPopIncrease + 24
            end
        end

        local total_pop_growth_modifier_ui = 0
        for id, data in pairs(fiefModifiers) do
            if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
                if data.effects and data.effects.population_growth_modifier then
                    total_pop_growth_modifier_ui = total_pop_growth_modifier_ui + data.effects.population_growth_modifier
                end
            end
        end
        if (getState(triggerId, "Toggle_TaxRelief") or 0) == 1 then
            total_pop_growth_modifier_ui = total_pop_growth_modifier_ui + 50
        end

        if minPopIncrease > 0 then 
            minPopIncrease = math.floor(minPopIncrease * (1 + total_pop_growth_modifier_ui / 100)) 
        end
        if maxPopIncrease > 0 then 
            maxPopIncrease = math.floor(maxPopIncrease * (1 + total_pop_growth_modifier_ui / 100)) 
        end
        
        setChatVar(triggerId, "cv_Fief_Pop_Increase_Min", math.max(0, minPopIncrease))
        setChatVar(triggerId, "cv_Fief_Pop_Increase_Max", math.max(0, maxPopIncrease))
    end

    -- 영지 등급 적정성 검사
    local currentPopulation = getState(triggerId, "Fief_Population") or 0
    local currentPower = getState(triggerId, "Fief_Power") or 0
    local isAppropriate = 0
    for _, levelInfo in ipairs(fiefLevelData) do
        if currentPopulation >= levelInfo.minPop and currentPopulation <= levelInfo.maxPop then
            if currentPower >= levelInfo.minPower then
                isAppropriate = 1
            end
            break 
        end
    end
    setChatVar(triggerId, "cv_power_level_appropriate", isAppropriate)

    -- 모디파이어 활성화 상태 체크
    local isAnyModifierActive = 0
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            isAnyModifierActive = 1
            break
        end
    end
    setChatVar(triggerId, "cv_modifier_active", isAnyModifierActive)
	
    local isPermanentModifierActive = 0
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 and data.permanent then
            isPermanentModifierActive = 1
            break
        end
    end
    setChatVar(triggerId, "cv_permanent_modifier_active", isPermanentModifierActive)

    local isTaskActive = 0
    for id, data in pairs(fiefModifiers) do
        if (getState(triggerId, "Fief_Modifier_" .. id) or 0) == 1 then
            if data.tags then
                for _, tag in ipairs(data.tags) do
                    if tag == "task" then
                        isTaskActive = 1
                        break
                    end
                end
            end
        end
        if isTaskActive == 1 then break end
    end
    setChatVar(triggerId, "cv_task", isTaskActive)
end

