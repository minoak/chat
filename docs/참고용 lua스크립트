function handleQuestResults(triggerId, affectionMultiplier)
    local statMultiplier = getState(triggerId, "statMultiplier") or 1

    local lastQuestType = getState(triggerId, "last_quest_type")
    
    if lastQuestType and isFiefSystemActive(triggerId) then
        local questRewardCheck = questTypeRewards[lastQuestType:lower()] 
        
        if questRewardCheck then
            local mainStat = questRewardCheck.main
            local mainStatChange = getState(triggerId, mainStat .. "_change") or 0

            local questTypeToModifier = {
                intel = "Intel_Quest_Bonus",
                supply = "Supply_Quest_Bonus",
                reputation = "Reputation_Quest_Bonus",
                stability = "Stability_Quest_Bonus",
                purity = "Purity_Quest_Bonus"
            }
            local modifierId = questTypeToModifier[lastQuestType:lower()]

            if modifierId and mainStatChange > 0 then
                setStateTracked(triggerId, "Fief_Modifier_" .. modifierId, 1)
            end
        end
    end

    local reward_parts = {}
    local lang = getState(triggerId, "Language") or 0

    for _, statName in ipairs(stats) do
        local current_stat = getState(triggerId, statName) or 0
        local old_tier_name = getStatTierName(triggerId, current_stat)
        
        local change = getState(triggerId, statName .. "_change") or 0
        local final_stat_change = change * statMultiplier
        local new_stat_score = current_stat + final_stat_change
        new_stat_score = math.min(math.max(new_stat_score, MIN_STAT), MAX_STAT)

        if final_stat_change > 0 then
            local statDisplayName = (lang == 1) and (statNames_KO[statName] or statName) or (statName:sub(1,1):upper() .. statName:sub(2))
            -- ### 수정된 부분: 증가량과 최종 값을 모두 표시 ###
            if lang == 1 then
                table.insert(reward_parts, string.format("%s +%d (→ %d)", statDisplayName, math.floor(final_stat_change), new_stat_score))
            else
                table.insert(reward_parts, string.format("%s +%d (→ %d)", statDisplayName, math.floor(final_stat_change), new_stat_score))
            end
        end

        local new_tier_name = getStatTierName(triggerId, new_stat_score)
        if old_tier_name ~= new_tier_name then
            local statDisplayName = (lang == 1) and (statNames_KO[statName] or statName) or (statName:sub(1,1):upper() .. statName:sub(2))
            
            local message = (lang == 1) and
                string.format("\n- System: 📈 %s 스탯 등급이 [%s]이(가) 되었습니다.\n", statDisplayName, new_tier_name) or
                string.format("\n- System: 📈 Your %s stat has become [%s].\n", statDisplayName, new_tier_name)
            addNotification(triggerId, message)
        end
        
        setStateTracked(triggerId, statName, new_stat_score)
        setChatVar(triggerId, "cv_" .. statName, tostring(new_stat_score))
    end

    if #reward_parts > 0 then
        local prefix = (lang == 1) and "퀘스트 보상: " or "Quest Reward: "
        local reward_string = table.concat(reward_parts, ", ")
        addNotification(triggerId, "\n- System: 📈 " .. prefix .. reward_string)
    end
end

