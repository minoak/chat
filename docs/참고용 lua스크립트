local session_notifications_manager = {}

function addNotification(triggerId, message)
    if not session_notifications_manager[triggerId] then
        session_notifications_manager[triggerId] = {}
    end
    table.insert(session_notifications_manager[triggerId], message)
end

function recordPendingChange(triggerId, key, change)
    local pending = getState(triggerId, "pending_changes") or {}
    pending[key] = (pending[key] or 0) + change
    setState(triggerId, "pending_changes", pending)
    print(string.format("Recorded PENDING CHANGE: %s by %+d", key, change))
end

function recordPendingOverwrite(triggerId, key, value)
    local pending = getState(triggerId, "pending_overwrites") or {}
    pending[key] = value
    setState(triggerId, "pending_overwrites", pending)
    print(string.format("Recorded PENDING OVERWRITE: %s = %s", key, tostring(value)))
end

function onStart(triggerId)
    print("==========================================================")
    print("[DEBUG] onStart function initiated for triggerId: " .. tostring(triggerId))

    -- ### 수정된 부분: session_initialized_flags 대신 getState 사용 ###
    -- getState를 통해 세션이 초기화되었는지 여부를 영구적으로 확인합니다.
    local is_session_initialized = getState(triggerId, "session_initialized")

    print("[DEBUG] Attempting to execute loadLatestStateFromHistory...")
    local load_success, load_err = pcall(loadLatestStateFromHistory, triggerId)
    if not load_success then
        print("[!! ERROR !!] An error occurred inside 'loadLatestStateFromHistory': " .. tostring(load_err))
        alertError(triggerId, "Error loading state from history. Check console (F12) for details.")
    end
    print("[DEBUG] Finished executing loadLatestStateFromHistory. Success: " .. tostring(load_success))

    print("[DEBUG] Attempting to execute resyncAllSkillBonuses...")
    local resync_success, resync_err = pcall(resyncAllSkillBonuses, triggerId)
    if not resync_success then
        print("[!! ERROR !!] An error occurred inside 'resyncAllskillBonuses': " .. tostring(resync_err))
        alertError(triggerId, "Error resyncing skill bonuses. Check console (F12) for details.")
    end
    print("[DEBUG] Finished executing resyncAllSkillBonuses. Success: " .. tostring(resync_success))
    
    if getState(triggerId, "FiefSystemInitialized") == nil then
        setState(triggerId, "FiefSystemInitialized", false)
    end
    
    -- ### 수정된 부분: 초기화 확인 로직 변경 ###
    -- is_session_initialized가 true가 아닐 경우 (nil이거나 false일 경우)에만 초기화를 실행합니다.
    if not is_session_initialized then
        print("[DEBUG] >>> Session not initialized. Entering one-time init block.")
        
        print("--- Performing one-time system status sync ---")
        -- ### ★★★ 수정된 부분: systemsToSync 테이블에서 호감도 항목 제거 ###
        local systemsToSync = {
            { cv = "cv_RPG", state = "RPG" },
            { cv = "cv_Quest", state = nil }
        }

        for _, sys in ipairs(systemsToSync) do
            local cv_value = getChatVar(triggerId, sys.cv)
            if cv_value ~= "0" then
                if sys.state then
                    setState(triggerId, sys.state, 1)
                end
                setChatVar(triggerId, sys.cv, 1)
                print(string.format("  - System '%s' is not explicitly '0'. Activating.", sys.cv))
            end
        end

        -- ### ★★★ 추가된 부분: 호감도 시스템을 명시적으로 비활성화 ###
        -- 호감도 시스템 상태가 정의되지 않았다면 (완전히 새로운 채팅), 기본적으로 '꺼짐'으로 설정합니다.
        if getState(triggerId, "Affection") == nil then
            print("  - Affection system state is not set. Defaulting to OFF.")
            setState(triggerId, "Affection", 0)
            setChatVar(triggerId, "cv_Affection", 0)
        end
        print("--- System sync complete ---")

        initializeAffectionVariables(triggerId)
        initializeStatVariables(triggerId)
		initializeCharacterAndSkillSystem(triggerId)
        
        if getState(triggerId, "statusPanel_Mode") == nil then
            setState(triggerId, "statusPanel_Mode", "2")
            setChatVar(triggerId, "statusPanel_Mode_Text", "보조 모델")
        end
        
        -- ### 수정된 부분: setState를 사용하여 영구 플래그 설정 ###
        setState(triggerId, "session_initialized", true)
        
        print("[DEBUG] <<< Session initialization complete. Flag 'session_initialized' has been set to TRUE.")
    else
        print("[DEBUG] >>> Session already initialized. Skipping one-time init block.")
    end

    local cheatStateVars = {
        "Cheat_Material_Bonus", "Cheat_Material_Flat",
        "Cheat_Gold_Bonus", "Cheat_Gold_Flat",
        "Cheat_Food_Bonus", "Cheat_Food_Flat"
    }
	
    for _, varName in ipairs(cheatStateVars) do
        local value = getState(triggerId, varName) or 0
        setState(triggerId, varName, value)
        setChatVar(triggerId, "cv_" .. varName, value)
    end

    setChatVar(triggerId, "cv_assetfolding", getState(triggerId, "assetfolding"))

    if getState(triggerId, "Language") == nil then
        setState(triggerId, "Language", 0) 
    end
	
    setChatVar(triggerId, "cv_Language", getState(triggerId, "Language"))
	
    print("[DEBUG] onStart function finished.")
    print("==========================================================")
end

function removeTaggedContent(text)
    if type(text) ~= "string" then return "" end
    local sections = {}
    local position = 1
    while position <= #text do
        local tagStart = text:find("<", position)
        if not tagStart then break end

        local tagEnd = text:find(">", tagStart)
        if not tagEnd then
            position = tagStart + 1
        else
            local fullTag = text:sub(tagStart + 1, tagEnd - 1)
            local tagName = fullTag:match("^([%w%-%_]+)")

            if not tagName or tagName == "lb-board" then
                position = tagEnd + 1
            else 
                local closePattern = "</" .. tagName .. ">"
                local closeStart = text:find(closePattern, tagEnd)
                if closeStart then
                    local closeEnd = closeStart + #closePattern
                    table.insert(sections, { start = tagStart, finish = closeEnd })
                    position = closeEnd
                else
                    position = tagEnd + 1
                end
            end
        end
    end

    if #sections == 0 then return text end
    table.sort(sections, function(a, b) return a.start > b.start end)
    local result = text
    for _, section in ipairs(sections) do
        result = result:sub(1, section.start - 1) .. result:sub(section.finish)
    end
    return result
end

function removeThoughts(text)
    if type(text) ~= "string" then return "" end
    local lc = text:lower()
    local sections = {}
    local pos = 1
    while true do
        local s, e, tag = lc:find("<(thoughts?)[^>]*>", pos)
        if not s then break end
        local closePattern = "</" .. tag .. ">"
        local cs, ce = lc:find(closePattern, e + 1, true)
        if cs then
            table.insert(sections, { start = s, finish = ce })
            pos = ce + 1
        else
            pos = e + 1
        end
    end
    if #sections == 0 then
        return text
    end
    table.sort(sections, function(a, b) return a.start > b.start end)
    local result = text
    for _, sec in ipairs(sections) do
        result = result:sub(1, sec.start - 1) .. result:sub(sec.finish + 1)
    end
    return result
end

function truncateRepeats(str, m)
    if type(str) ~= "string" then return "" end
    local maxCount = m or 4
    local prev, cnt = nil, 0
    local out = {}
    for ch in str:gmatch("([%z\1-\127\194-\244][\128-\191]*)") do
        if ch == prev then
            cnt = cnt + 1
        else
            prev, cnt = ch, 1
        end
        if cnt <= maxCount then
            out[#out + 1] = ch
        end
    end
    return table.concat(out)
end

