function applyFiefResourceCheat(triggerId, resourceName, changeAmount)
    local stateKey = "Fief_" .. resourceName
    local maxStateKey = stateKey .. "_Max"

    local currentValue = getState(triggerId, stateKey) or 0
    local maxValue = getState(triggerId, maxStateKey) or 9999

    local newValue = currentValue + changeAmount
    
    if newValue < 0 then newValue = 0 end
    if newValue > maxValue then newValue = maxValue end

    setState(triggerId, stateKey, newValue)
    setChatVar(triggerId, "cv_" .. stateKey, newValue)

    local lang = getState(triggerId, "Language") or 0
    local actionText = (lang == 1) and (changeAmount >= 0 and "만큼 증가하여" or "만큼 감소하여") or (changeAmount >= 0 and "increased by" or "decreased by")
    
    local message
    if lang == 1 then
        message = "영지 자원 '" .. resourceName .. "'이(가) " .. math.abs(changeAmount) .. actionText .. " " .. newValue .. "이(가) 되었습니다."
    else
        message = "Fief resource '" .. resourceName .. "' has " .. actionText .. " " .. math.abs(changeAmount) .. " to " .. newValue .. "."
    end
    alertNormal(triggerId, message)

    recordTemporaryChange(triggerId, stateKey, newValue)
end


function unlockSpecialBuildingCheat(triggerId, buildingVarName, buildingDisplayName)
    local stateKey = "Fief_" .. buildingVarName
    local lang = getState(triggerId, "Language") or 0
    
    if (getState(triggerId, stateKey) or 0) == 1 then
        local errorMessage = (lang == 1) and ("'" .. buildingDisplayName .. "'은(는) 이미 잠금 해제되었습니다.") or ("'" .. buildingDisplayName .. "' is already unlocked.")
        alertError(triggerId, errorMessage)
        return
    end

    setState(triggerId, stateKey, 1)
    setChatVar(triggerId, "cv_" .. buildingVarName, 1)

    local successMessage = (lang == 1) and ("특수 건물 '" .. buildingDisplayName .. "'이(가) 성공적으로 잠금 해제되었습니다!") or ("Special building '" .. buildingDisplayName .. "' has been successfully unlocked!")
    alertNormal(triggerId, successMessage)
    
    recordTemporaryChange(triggerId, stateKey, 1)
end


