function updateAffectionScoreAndDisplay(triggerId)
    local affectionMultiplier = getState(triggerId, "affectionMultiplier") or 1
    local reputationBonus = calculateReputationBonus(triggerId)
    
    -- ### 추가된 부분: 턴 시작 시 모든 캐릭터의 변화량 cv_ 변수를 0으로 초기화 ###
    for _, name in ipairs(characters) do
        setChatVar(triggerId, "cv_" .. name .. "affchange", 0)
    end
    -- ######################################################################

    for _, name in ipairs(characters) do
        local pending_change = getState(triggerId, name .. "affchange") or 0
        if pending_change ~= 0 then
            local current_score = getState(triggerId, name .. "aff") or 0
            local old_tier_name = getAffectionTierName(triggerId, current_score)

            local bonus_points = 0
            if pending_change > 0 then
                bonus_points = bonus_points + reputationBonus
                if (getState(triggerId, "Perk_Seducer_acquired") or 0) == 1 then
                    bonus_points = bonus_points + 2
                end
            end
            
            local total_base_change = pending_change + bonus_points
            local final_change = total_base_change * affectionMultiplier
            
            -- ### 추가된 부분: 계산된 최종 변화량을 cv_ 변수에 저장 ###
            setChatVar(triggerId, "cv_" .. name .. "affchange", final_change)
            -- #########################################################
            
            local new_master_score = current_score + final_change
            if new_master_score > MAX_AFF then new_master_score = MAX_AFF end
            if new_master_score < MIN_AFF then new_master_score = MIN_AFF end
            
            local new_tier_name = getAffectionTierName(triggerId, new_master_score)
            if old_tier_name ~= new_tier_name then
                local lang = getState(triggerId, "Language") or 0
                local message = (lang == 1) and
                    string.format("\n\n- System: 💖 %s와(과)의 관계가 [%s] (으)로 발전했습니다.\n", name, new_tier_name) or
                    string.format("\n\n- System: 💖 Your relationship with %s has become [%s].\n", name, new_tier_name)
                addNotification(triggerId, message)
            end
            
            setStateTracked(triggerId, name .. "aff", new_master_score)
            setChatVar(triggerId, "cv_" .. name .. "aff", new_master_score)
        end
    end
end

function processAffectionChangesInOutput(triggerId, text)
    if not text then return end

    for _, name in ipairs(characters) do
        if getState(triggerId, name .. "affchange") == nil then
            setState(triggerId, name .. "affchange", 0)
        end
    end

    for name, feeling in text:gmatch("%[([^:]+):%s*([^%]]+)%s*%]") do
        name = name:match("^%s*(.-)%s*$")
        feeling = feeling:match("^%s*(.-)%s*$")
        local change = affectionChanges[feeling]
        if change ~= nil then
            for _, target_char_name in ipairs(characters) do
                if target_char_name:lower() == name:lower() then
                    -- ### 수정: 기존 값을 덮어쓰는 대신, 현재 값에 변화량을 '더합니다'. ###
                    local current_change = getState(triggerId, target_char_name .. "affchange") or 0
                    setState(triggerId, target_char_name .. "affchange", current_change + change)
                    break
                end
            end
        end
    end
end

function processQuestDefinition(triggerId, text)
    local validDifficulties = {easy = true, normal = true, hard = true}

    for block in text:gmatch("%[.-%]") do
        
        -- ### ★★★★★ 바로 이 부분이 수정되었습니다 ★★★★★ ###
        -- 1. 파이프(|) 개수를 6개로 확인합니다. (기존 5개)
        local _, pipe_count = block:gsub("|", "|")
        
        if pipe_count == 6 then
            local content = block:sub(2, -2)
            local parts = {}
            for part in content:gmatch("([^|]*)") do
                table.insert(parts, part)
            end
            
            -- 2. 첫 번째 항목이 "Quest Status"인지 확인합니다.
            local status_field = parts[1]:match("^%s*(.-)%s*$")
            
            if status_field == "Quest Status" then
                -- 3. 데이터 위치가 한 칸씩 뒤로 밀렸으므로, 새로운 인덱스를 사용합니다.
                local potentialDifficulty = parts[5]:match("^%s*(.-)%s*$"):lower() -- 기존 parts[4]
                local potentialType = parts[6]:match("^%s*(.-)%s*$"):lower()     -- 기존 parts[5]
                
                if validDifficulties[potentialDifficulty] and questTypeRewards[potentialType] then
                    -- 모든 조건이 맞으면 퀘스트로 확정합니다.
                    setState(triggerId, "pending_quest_difficulty", potentialDifficulty)
                    setState(triggerId, "pending_quest_type", potentialType)
                    setState(triggerId, "pending_quest_giver", parts[7]:match("^%s*(.-)%s*$")) -- 기존 parts[6]
                    
                    print("SUCCESS: A valid new-format quest block was confirmed and parsed.")
                    
                    return
                end
            end
        end
        -- ### 수정 끝 ###
    end
end

function applyQuestCompletionRewards(triggerId)
    -- ### DEBUG START ###
    print("==========================================================")
    print("[DEBUG] Running applyQuestCompletionRewards...")

    local difficulty = getState(triggerId, "current_quest_difficulty")
    local questType = getState(triggerId, "current_quest_type")
    local giver = getState(triggerId, "current_quest_giver")

    print(string.format("  - Retrieved Quest Info: Difficulty=%s, Type=%s, Giver=%s",
        tostring(difficulty), tostring(questType), tostring(giver)))
    -- ### DEBUG END ###

    if not (difficulty and questType and giver) then
        alertError(triggerId, "완료할 퀘스트가 활성화되어 있지 않습니다!")
        print("  - [ERROR] Quest completion failed: No active quest data found.")
        print("==========================================================")
        return
    end

    local difficultySetting = difficultyValues[difficulty:lower()]
    if not difficultySetting then
        print("  - [WARNING] Invalid difficulty. Processing as 'normal'.")
        difficultySetting = difficultyValues["normal"]
    end

    local questReward = questTypeRewards[questType:lower()]

    if not questReward then
        print("  - Processing as a 'General' quest type.")
        for _, statName in ipairs(stats) do
            setState(triggerId, statName .. "_change", 10)
        end
        setState(triggerId, "last_quest_type", "general")
    else
        print("  - Processing as a 'Standard' quest type.")
        setState(triggerId, "last_quest_type", questType)

        -- ### ★★★★★ 수정된 부분 시작 ★★★★★ ###
        local specialMultiplier = 1
        local questTypeLower = questType:lower()

        if questTypeLower == "supply" or questTypeLower == "purity" then
            specialMultiplier = 2
            print(string.format("  - Applying 2x reward multiplier for '%s' quest type's MAIN stat.", questType))
        end

        -- 주 스탯 보상에만 특별 배율을 적용합니다.
        local finalMainChange = difficultySetting.mainChange * specialMultiplier
        -- 부 스탯 보상은 원래 값 그대로 유지합니다.
        local finalSubChange = difficultySetting.subChange
        
        setState(triggerId, questReward.main .. "_change", finalMainChange)
        setState(triggerId, questReward.sub .. "_change", finalSubChange)
        -- ### ★★★★★ 수정된 부분 끝 ★★★★★ ###
    end
    
    -- ### 수정됨: Stability 보너스를 Reputation 보너스로 교체 ###
    local reputationBonus = calculateReputationBonus(triggerId)
    local baseAffGain = difficultySetting.baseAffGain + reputationBonus
    local current_change = getState(triggerId, giver .. "affchange") or 0
    
    -- ### DEBUG START ###
    print("  --- Affection Reward Calculation ---")
    print(string.format("  - Target Character (Giver): %s", giver))
    print(string.format("  - Difficulty Base Gain: %d", difficultySetting.baseAffGain))
    print(string.format("  - Reputation Bonus: %d", reputationBonus)) -- 로그 메시지도 수정
    print(string.format("  - Total Affection Gain for this quest: %d", baseAffGain))
    print(string.format("  - Pending affection change for %s (before this quest): %d", giver, current_change))
    -- ### DEBUG END ###

    setState(triggerId, giver .. "affchange", current_change + baseAffGain)
    
    -- ### DEBUG START ###
    print(string.format("  - SET STATE: %s with new pending change of %d", giver .. "affchange", current_change + baseAffGain))
    -- ### DEBUG END ###

    setState(triggerId, "pending_quest_clear", true)
    print("  - Quest processing complete.")
    print("==========================================================")
end

