function generateUserSkillLevelsDescription(triggerId)
    local skill_lines = {}
    
    local header = "### {{user}}'s Skill Levels\n- Refer to these skill levels to generate appropriate and consistent choices."
    table.insert(skill_lines, header)

    for _, skillName in ipairs(skills) do
        local keyName = skillName:gsub(" ", "_")
        -- ### 수정됨: 'bonus' 대신 'points'를 가져옵니다. ###
        local points = getState(triggerId, keyName .. "_points") or 0
        -- ### 수정됨: 새로운 포인트 기반 함수를 사용합니다. ###
        local levelName = getSkillLevelNameFromPoints(points)
        
        table.insert(skill_lines, string.format("- %s: %s", skillName, levelName))
    end

    if #skill_lines > 1 then
        return table.concat(skill_lines, "\n") .. "\n"
    end
    
    return ""
end

function generateOwnedPerksDisplayString(triggerId)
    -- RPG 모드가 꺼져 있으면 아무것도 반환하지 않습니다.
    if (getState(triggerId, "RPG") or 0) ~= 1 then
        return ""
    end

    local ownedPerksNames = {}

    -- perks 테이블에 정의된 모든 퍽을 순회합니다.
    for perkId, perkData in pairs(perks) do
        -- 해당 퍽을 습득했고(값이 1), 프롬프트용 설명이 있는지 확인합니다.
        if (getState(triggerId, "Perk_" .. perkId .. "_acquired") or 0) == 1 and perkData.prompt_desc and perkData.prompt_desc ~= "" then
            -- perkId의 언더스코어(_)를 공백으로 바꾸어 이름으로 사용합니다.
            local perkName = perkId:gsub("_", " ")
            table.insert(ownedPerksNames, perkName)
        end
    end

    -- 습득한 퍽이 하나라도 있을 경우에만 지정된 형식으로 문자열을 반환합니다.
    if #ownedPerksNames > 0 then
        -- ### 수정됨: "Owned Perks: " 접두어 추가 ###
        return "<-Owned Perks: " .. table.concat(ownedPerksNames, ", ") .. "->"
    end


    -- 해당하는 퍽이 없으면 빈 문자열을 반환합니다.
    return ""
end

