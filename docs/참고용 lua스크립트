    end)

    d = d:gsub("%[([%w%s]+)%|([^|]+)%|([^|]*)%|([^|]*)%|Difficulty Modifier:%s*([^%]]+)%]", function(skill, description, tooltip1, tooltip2, difficultyLabel)
        
        local modifierMap = {
            Easy = -3,
            Normal = 0,
            Hard = 3,
