        local modifierValue = modifierMap[difficultyLabel] or 0
        
        local btn_data = table.concat({skill, description, tooltip1, tooltip2, tostring(modifierValue)}, "~")
        
        local button_html = string.format([[
			<body>
            <button risu-btn="PerformDiceRoll~%s" class="custom-choice-button">
                <strong>[%s]</strong> %s
