-- Main execution logic
listenEdit("editDisplay", function(triggerId, data)
    if not data or data == "" then return "" end

    local replacements = {}
    local output = ""
    local lastIndex = 1

    local success, result = pcall(extractAllSkBlocks, data)
    if success then replacements = result
    else print("[listenEdit] !!! extractAllSkBlocks Error:", result); return data end

    if replacements and #replacements > 0 then
        for i, match in ipairs(replacements) do
            if match.rangeStart > lastIndex then output = output .. data:sub(lastIndex, match.rangeStart - 1) end
            local processSuccess, processedContent = pcall(processSkBlock, triggerId, match.content)
            if processSuccess then
                output = output .. processedContent
            else
                -- Log the error and insert a placeholder comment in the output
                print(string.format("[listenEdit] !!! processSkBlock Error (Block %d): %s", i, processedContent))
                output = output .. "<!-- StockKorp Block Error -->"
            end
            -- Update the index to continue searching after the current block
            lastIndex = match.rangeEnd + 1
        end
    else
        -- No SK blocks found, ensure lastIndex is 1 so the entire original data is appended later
        lastIndex = 1
    end

    -- Append any remaining text after the last processed SK block (or the entire original text if no blocks were found)
    if lastIndex <= #data then
        output = output .. data:sub(lastIndex)
    end

    -- Return the final processed output
    return output
end)