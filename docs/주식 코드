-- Base value ranges by company tier (for when no history exists)
local STOCK_TIERS = {
    premium = {"AR", "MI", "TT", "RF", "BI", "NE", "OA", "PE"}, -- 500-2000 eddies
    standard = {"KT", "DE", "NC", "QI", "LA", "KI", "CY", "ZE", "TS", "MO"}, -- 100-500 eddies
    budget = {"AF", "AS", "DA", "DM", "DT", "DY", "EZ", "KA", "NP", "NN", "QU", "RA", "TH", "WN"} -- 10-100 eddies
}

-- 1. extractAllSkBlocks function (adapted from NH function)
local function extractAllSkBlocks(text)
    local results = {}
    local i = 1
    while true do
        local startIdx, prefixEnd = text:find("SK%[", i)
        if not startIdx then break end
        local bracketLevel = 1
        local endIdx = prefixEnd + 1
        local searchEnd = #text
        while endIdx <= searchEnd do
            local char = text:sub(endIdx, endIdx)
            if char == "[" then bracketLevel = bracketLevel + 1
            elseif char == "]" then bracketLevel = bracketLevel - 1 end
            if bracketLevel == 0 then break end
            endIdx = endIdx + 1
        end
        if bracketLevel == 0 then
            local contentOnly = text:sub(prefixEnd + 1, endIdx - 1)
            table.insert(results, { content = contentOnly, rangeStart = startIdx, rangeEnd = endIdx })
            i = endIdx + 1
        else
            i = prefixEnd + 1
        end
    end
    return results
end

-- 2. getCompanyTier function to determine stock price range
local function getCompanyTier(stockCode)
    for tier, companies in pairs(STOCK_TIERS) do
        for _, code in ipairs(companies) do
            if code == stockCode then
                return tier
            end
        end
    end
    return "standard" -- Default to standard tier if not found
end

-- 3. generateBasePrice function
local function generateBasePrice(stockCode)
    local tier = getCompanyTier(stockCode)
    local basePrice = 0
    
    if tier == "premium" then
        basePrice = math.random(500, 2000)
    elseif tier == "standard" then
        basePrice = math.random(100, 500)
    else -- budget
        basePrice = math.random(10, 100)
    end
    
    return basePrice
end

-- 4. generateRandomChange function
local function generateRandomChange(currentPrice)
    local changePercent = math.random(-10, 10) -- -10% to +10% change
    local change = currentPrice * (changePercent / 100)
    return math.floor(currentPrice + change)
end

-- 5. processSkBlock function
local function processSkBlock(triggerId, raw_content)
    if not raw_content or raw_content == "" then return "[StockKorp Error: Empty Content]" end

    local stockData = {}
    local updatedStocks = {}
    local stockHistory = {}

    -- Parse the stock data from the input
    local segments = {}
    local customDate = nil
    local customTime = nil
    
    for seg in string.gmatch(raw_content, "([^|]+)") do
        table.insert(segments, seg)
    end

    for _, segment in ipairs(segments) do
        local stockCode, value = segment:match("^([%u%d_]+):(.+)$")
        
        if stockCode and value then
            -- Trim whitespace
            value = string.gsub(value, "^%s+", "")
            value = string.gsub(value, "%s+$", "")
            
            -- Check if this is a date or time specifier
            if stockCode == "SKDATE" then
                customDate = value
            elseif stockCode == "SKTIME" then
                customTime = value
            else
                -- Convert to number (if possible)
                local numPrice = tonumber(value)
                if numPrice then
                    stockData[stockCode] = numPrice
                    
                    -- If this is a valid stock, mark it as updated
                    if STOCK_COMPANIES[stockCode] then
                        updatedStocks[stockCode] = true
                    end
                end
            end
        end
    end

    -- For each valid stock code, check if we have history
    for stockCode, _ in pairs(STOCK_COMPANIES) do
        -- Try to load history from chat variables
        local historyVar = getChatVar(triggerId, "stock_" .. stockCode)
        
        if historyVar and historyVar ~= "" then
            -- Parse the history string into a table
            stockHistory[stockCode] = {}
            for value in string.gmatch(historyVar, "([^,]+)") do
                table.insert(stockHistory[stockCode], tonumber(value))
            end
        else
            -- Initialize with empty history
            stockHistory[stockCode] = {}
        end
        
        -- If this stock wasn't in the current update
        if not updatedStocks[stockCode] then
            -- Generate a value if we don't have history
            if #stockHistory[stockCode] == 0 then
                stockData[stockCode] = generateBasePrice(stockCode)
            else
                -- Use the last value as base and create a random change
                local lastValue = stockHistory[stockCode][#stockHistory[stockCode]]
                stockData[stockCode] = generateRandomChange(lastValue)
            end
        end
        
        -- Ensure we don't go below 1
        if stockData[stockCode] < 1 then
            stockData[stockCode] = 1
        end
        
        -- Add the current value to history
        table.insert(stockHistory[stockCode], stockData[stockCode])
        
        -- Keep only the last 10 values
        if #stockHistory[stockCode] > 10 then
            local newHistory = {}
            for i = #stockHistory[stockCode] - 9, #stockHistory[stockCode] do
                table.insert(newHistory, stockHistory[stockCode][i])
            end
            stockHistory[stockCode] = newHistory
        end
        
        -- Save the updated history back to chat variables
        local historyString = table.concat(stockHistory[stockCode], ",")
        setChatVar(triggerId, "stock_" .. stockCode, historyString)
    end

    -- Calculate trends and percentages
    local stockTrends = {}
    local stockChanges = {}
    
    for stockCode, history in pairs(stockHistory) do
        if #history >= 2 then
            local current = history[#history]
            local previous = history[#history - 1]
            
            if current > previous then
                stockTrends[stockCode] = "up"
            elseif current < previous then
                stockTrends[stockCode] = "down"
            else
                stockTrends[stockCode] = "stable"
            end
            
            stockChanges[stockCode] = ((current - previous) / previous) * 100
        else
            stockTrends[stockCode] = "stable"
            stockChanges[stockCode] = 0
        end
    end

