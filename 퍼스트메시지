<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>벨라도나 아카데미 - 관계 설정</title>
<style>
.bella-ui-widget{all:initial;font-family:'Pretendard',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:block;width:100%;max-width:900px;box-sizing:border-box;margin:0}
.bella-ui-widget *{margin:0;padding:0;box-sizing:border-box}
.bella-ui-wrapper{background:#1a1a1f;min-height:200px;display:flex;flex-direction:column;padding:16px 20px;position:relative;border-radius:12px;color:#f5f5f7;border:1px solid#2c2c35;box-shadow:0 0 20px rgba(139,92,246,0.1)}
.bella-ui-title{text-align:center;font-size:20px;font-weight:700;margin-bottom:8px;color:#f5f5f7;letter-spacing:-0.5px;text-shadow:0 0 10px rgba(139,92,246,0.3)}
.bella-ui-subtitle{font-size:11px;font-weight:500;color:#a0a0ab;margin-bottom:16px;text-align:center;letter-spacing:0.3px}

/* 상위 카테고리 탭 (메인/서브) */
.bella-category-tabs{display:flex;gap:8px;margin-bottom:12px;justify-content:center}
.bella-category-radio{position:absolute;opacity:0;pointer-events:none}
.bella-category-btn{padding:10px 24px;background:#25252d;color:#a0a0ab;cursor:pointer;font-size:13px;font-weight:700;border-radius:10px;transition:all 0.2s ease;border:1px solid #35354a}
.bella-category-btn:hover{background:#2c2c35;color:#f5f5f7}
#cat-main:checked + label{background:#8b5cf6;color:#ffffff;border-color:#8b5cf6;box-shadow:0 2px 10px rgba(139,92,246,0.4)}
#cat-sub:checked + label{background:#ec4899;color:#ffffff;border-color:#ec4899;box-shadow:0 2px 10px rgba(236,72,153,0.4)}

/* 캐릭터 탭 컨테이너 */
.bella-main-chars,.bella-sub-chars{display:none}
#cat-main:checked ~ .bella-main-chars{display:block}
#cat-sub:checked ~ .bella-sub-chars{display:block}

.bella-ui-tabs{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;background:#25252d;padding:4px;border-radius:10px}
.bella-ui-tab-radio{position:absolute;opacity:0;pointer-events:none}
.bella-ui-tab-btn{padding:8px 14px;background:transparent;color:#a0a0ab;cursor:pointer;font-size:11px;font-weight:600;border-radius:8px;transition:all 0.2s ease;white-space:nowrap}
.bella-ui-tab-btn:hover{background:#2c2c35;color:#f5f5f7}

/* 메인 캐릭터 탭 스타일 */
#tab-mirabel:checked + label,#tab-celestia:checked + label,#tab-cassandra:checked + label,#tab-evangeline:checked + label,#tab-amelia:checked + label,#tab-nepenthes:checked + label,#tab-lilith:checked + label,#tab-aurelia:checked + label{background:#8b5cf6;color:#ffffff;box-shadow:0 2px 8px rgba(139,92,246,0.3)}

/* 서브 캐릭터 탭 스타일 */
#tab-cordelia:checked + label,#tab-suah:checked + label,#tab-adelheid:checked + label,#tab-rosalie:checked + label,#tab-mika:checked + label,#tab-clover:checked + label,#tab-noctis:checked + label,#tab-pennywise:checked + label,#tab-vivienne:checked + label,#tab-scar:checked + label,#tab-robert:checked + label,#tab-margot:checked + label,#tab-lydia:checked + label,#tab-hemlock:checked + label,#tab-margaret:checked + label{background:#ec4899;color:#ffffff;box-shadow:0 2px 8px rgba(236,72,153,0.3)}

.bella-ui-content-wrapper{position:relative;min-height:320px}
.bella-ui-content-container{display:none}

/* 메인 캐릭터 콘텐츠 표시 */
#tab-mirabel:checked ~ .bella-ui-content-wrapper .bella-ui-content-mirabel{display:block}
#tab-celestia:checked ~ .bella-ui-content-wrapper .bella-ui-content-celestia{display:block}
#tab-cassandra:checked ~ .bella-ui-content-wrapper .bella-ui-content-cassandra{display:block}
#tab-evangeline:checked ~ .bella-ui-content-wrapper .bella-ui-content-evangeline{display:block}
#tab-amelia:checked ~ .bella-ui-content-wrapper .bella-ui-content-amelia{display:block}
#tab-nepenthes:checked ~ .bella-ui-content-wrapper .bella-ui-content-nepenthes{display:block}
#tab-lilith:checked ~ .bella-ui-content-wrapper .bella-ui-content-lilith{display:block}
#tab-aurelia:checked ~ .bella-ui-content-wrapper .bella-ui-content-aurelia{display:block}

/* 서브 캐릭터 콘텐츠 표시 */
#tab-cordelia:checked ~ .bella-ui-content-wrapper .bella-ui-content-cordelia{display:block}
#tab-suah:checked ~ .bella-ui-content-wrapper .bella-ui-content-suah{display:block}
#tab-adelheid:checked ~ .bella-ui-content-wrapper .bella-ui-content-adelheid{display:block}
#tab-rosalie:checked ~ .bella-ui-content-wrapper .bella-ui-content-rosalie{display:block}
#tab-mika:checked ~ .bella-ui-content-wrapper .bella-ui-content-mika{display:block}
#tab-clover:checked ~ .bella-ui-content-wrapper .bella-ui-content-clover{display:block}
#tab-noctis:checked ~ .bella-ui-content-wrapper .bella-ui-content-noctis{display:block}
#tab-pennywise:checked ~ .bella-ui-content-wrapper .bella-ui-content-pennywise{display:block}
#tab-vivienne:checked ~ .bella-ui-content-wrapper .bella-ui-content-vivienne{display:block}
#tab-scar:checked ~ .bella-ui-content-wrapper .bella-ui-content-scar{display:block}
#tab-robert:checked ~ .bella-ui-content-wrapper .bella-ui-content-robert{display:block}
#tab-margot:checked ~ .bella-ui-content-wrapper .bella-ui-content-margot{display:block}
#tab-lydia:checked ~ .bella-ui-content-wrapper .bella-ui-content-lydia{display:block}
#tab-hemlock:checked ~ .bella-ui-content-wrapper .bella-ui-content-hemlock{display:block}
#tab-margaret:checked ~ .bella-ui-content-wrapper .bella-ui-content-margaret{display:block}

.bella-stat-section{background:#25252d;border-radius:10px;padding:16px;margin-bottom:16px;border:1px solid #35354a}
.bella-stat-title{font-size:14px;font-weight:700;margin-bottom:16px;text-align:center;color:#f5f5f7}
.bella-stat-group{margin-bottom:16px}
.bella-stat-label{font-size:13px;font-weight:600;color:#f5f5f7;margin-bottom:8px;display:block}
.bella-stat-buttons{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.bella-stat-buttons.sin-buttons{grid-template-columns:repeat(2,1fr)}
.bella-stat-btn{padding:8px 4px;background:#2c2c35;color:#f5f5f7;border:1px solid #35354a;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;transition:all 0.2s ease}
.bella-stat-btn:hover{background:#35354a;transform:translateY(-1px)}
.bella-stat-btn.negative{background:#dc2626;color:white;border:1px solid #ef4444}
.bella-stat-btn.positive{background:#ec4899;color:white;border:1px solid #f472b6}
.bella-stat-btn.pressure{background:#c85a54;color:white;border:1px solid #9b4a4a}
.bella-stat-btn.relief{background:#4a9bb8;color:white;border:1px solid #5ab88a}
.bella-scenario-section{background:#25252d;border-radius:10px;padding:16px;border:1px solid #35354a}
.bella-scenario-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.bella-scenario-btn{padding:12px 16px;background:#2c2c35;color:#f5f5f7;border:1px solid #35354a;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s ease;display:flex;align-items:center;gap:8px}
.bella-scenario-btn:hover{background:#8b5cf6;color:#ffffff;transform:translateY(-2px)}
.bella-common-section{background:#25252d;border-radius:10px;padding:16px;margin-top:16px;border:1px solid #35354a}
.bella-common-title{font-size:13px;font-weight:700;margin-bottom:12px;text-align:center;color:#f5f5f7}
.bella-scenario-grid.common-grid{grid-template-columns:repeat(3,1fr)}
.bella-placeholder{text-align:center;color:#6b6b7b;padding:40px 20px;font-size:13px}
@media(max-width:600px){.bella-ui-wrapper{padding:12px}.bella-scenario-grid{grid-template-columns:1fr}.bella-scenario-grid.common-grid{grid-template-columns:1fr}.bella-stat-buttons{grid-template-columns:repeat(2,1fr)}.bella-ui-tab-btn{padding:6px 10px;font-size:10px}}
</style>
</head>
<body>
<div class="bella-ui-widget">
<div class="bella-ui-wrapper">
<h1 class="bella-ui-title">🌺 벨라도나 아카데미 🌺</h1>
<div class="bella-ui-subtitle">캐릭터를 선택하고 초기 관계를 설정하세요</div>

<!-- 상위 카테고리 탭 -->
<input type="radio" name="category" id="cat-main" class="bella-category-radio" checked>
<input type="radio" name="category" id="cat-sub" class="bella-category-radio">
<div class="bella-category-tabs">
<label for="cat-main" class="bella-category-btn">⭐ 메인 캐릭터</label>
<label for="cat-sub" class="bella-category-btn">🌙 서브 캐릭터</label>
</div>

<!-- 메인 캐릭터 섹션 -->
<div class="bella-main-chars">
<input type="radio" name="main-tab" id="tab-mirabel" class="bella-ui-tab-radio" checked>
<input type="radio" name="main-tab" id="tab-celestia" class="bella-ui-tab-radio">
<input type="radio" name="main-tab" id="tab-cassandra" class="bella-ui-tab-radio">
<input type="radio" name="main-tab" id="tab-evangeline" class="bella-ui-tab-radio">
<input type="radio" name="main-tab" id="tab-amelia" class="bella-ui-tab-radio">
<input type="radio" name="main-tab" id="tab-nepenthes" class="bella-ui-tab-radio">
<input type="radio" name="main-tab" id="tab-lilith" class="bella-ui-tab-radio">
<input type="radio" name="main-tab" id="tab-aurelia" class="bella-ui-tab-radio">

<div class="bella-ui-tabs">
<label for="tab-mirabel" class="bella-ui-tab-btn">💰 미라벨</label>
<label for="tab-celestia" class="bella-ui-tab-btn">👑 셀레스티아</label>
<label for="tab-cassandra" class="bella-ui-tab-btn">⚔️ 카산드라</label>
<label for="tab-evangeline" class="bella-ui-tab-btn">💋 에반젤린</label>
<label for="tab-amelia" class="bella-ui-tab-btn">🎨 아멜리아</label>
<label for="tab-nepenthes" class="bella-ui-tab-btn">🧪 네펜테스</label>
<label for="tab-lilith" class="bella-ui-tab-btn">📱 릴리스</label>
<label for="tab-aurelia" class="bella-ui-tab-btn">☀️ 아우렐리아</label>
</div>

<div class="bella-ui-content-wrapper">

<!-- 미라벨 -->
<div class="bella-ui-content-container bella-ui-content-mirabel">
<div class="bella-stat-section">
<div class="bella-stat-title">💰 미라벨 폰 골든로제</div>
<div class="bella-stat-group">
<span class="bella-stat-label">💝 호감도 조정</span>
<div class="bella-stat-buttons">
<button type="button" class="bella-stat-btn negative" risu-trigger="adjust_mirabel_minus_100">-100</button>
<button type="button" class="bella-stat-btn negative" risu-trigger="adjust_mirabel_minus_50">-50</button>
<button type="button" class="bella-stat-btn positive" risu-trigger="adjust_mirabel_plus_50">+50</button>
<button type="button" class="bella-stat-btn positive" risu-trigger="adjust_mirabel_plus_100">+100</button>
</div>
</div>
<div class="bella-stat-group">
<span class="bella-stat-label">😈 탐욕 - 압력</span>
<div class="bella-stat-buttons sin-buttons">
<button type="button" class="bella-stat-btn pressure" risu-trigger="adjust_mirabel_sin_pos_plus_5">+5</button>
<button type="button" class="bella-stat-btn pressure" risu-trigger="adjust_mirabel_sin_pos_plus_15">+15</button>
</div>
</div>
<div class="bella-stat-group">
<span class="bella-stat-label">✨ 탐욕 - 해소</span>
<div class="bella-stat-buttons sin-buttons">
<button type="button" class="bella-stat-btn relief" risu-trigger="adjust_mirabel_sin_neg_plus_5">+5</button>
<button type="button" class="bella-stat-btn relief" risu-trigger="adjust_mirabel_sin_neg_plus_15">+15</button>
</div>
</div>
</div>
<div class="bella-scenario-section">
<div class="bella-scenario-grid">
<button type="button" class="bella-scenario-btn" risu-trigger="greeting1"><span>💸</span><span>채무 수금</span></button>
<button type="button" class="bella-scenario-btn" risu-trigger="greeting2"><span>🛍️</span><span>함께 쇼핑</span></button>
</div>
</div>
</div>

<!-- 셀레스티아 -->
<div class="bella-ui-content-container bella-ui-content-celestia">
<div class="bella-stat-section">
<div class="bella-stat-title">👑 셀레스티아 폰 실버크라운</div>
<div class="bella-stat-group">
<span class="bella-stat-label">💝 호감도 조정</span>
<div class="bella-stat-buttons">
<button type="button" class="bella-stat-btn negative" risu-trigger="adjust_celestia_minus_100">-100</button>
<button type="button" class="bella-stat-btn negative" risu-trigger="adjust_celestia_minus_50">-50</button>
<button type="button" class="bella-stat-btn positive" risu-trigger="adjust_celestia_plus_50">+50</button>
<button type="button" class="bella-stat-btn positive" risu-trigger="adjust_celestia_plus_100">+100</button>
</div>
</div>
<div class="bella-stat-group">
<span class="bella-stat-label">😈 오만 - 압력</span>
<div class="bella-stat-buttons sin-buttons">
<button type="button" class="bella-stat-btn pressure" risu-trigger="adjust_celestia_sin_pos_plus_5">+5</button>
<button type="button" class="bella-stat-btn pressure" risu-trigger="adjust_celestia_sin_pos_plus_15">+15</button>
</div>
</div>
<div class="bella-stat-group">
<span class="bella-stat-label">✨ 오만 - 해소</span>
<div class="bella-stat-buttons sin-buttons">
<button type="button" class="bella-stat-btn relief" risu-trigger="adjust_celestia_sin_neg_plus_5">+5</button>
<button type="button" class="bella-stat-btn relief" risu-trigger="adjust_celestia_sin_neg_plus_15">+15</button>
</div>
</div>
</div>
<div class="bella-scenario-section">
<div class="bella-scenario-grid">
<button type="button" class="bella-scenario-btn" risu-trigger="greeting3"><span>☕</span><span>티타임</span></button>
<button type="button" class="bella-scenario-btn" risu-trigger="greeting4"><span>🌃</span><span>변장 만남</span></button>
</div>
</div>
</div>

<!-- 카산드라 -->
<div class="bella-ui-content-container bella-ui-content-cassandra">
<div class="bella-stat-section">
<div class="bella-stat-title">⚔️ 카산드라 폰 울프하트</div>
