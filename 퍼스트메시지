<div class="bella-scenario-grid">
<button type="button" class="bella-scenario-btn" risu-trigger="greeting5"><span>💪</span><span>함께 운동</span></button>
<button type="button" class="bella-scenario-btn" risu-trigger="greeting6"><span>📚</span><span>만화 구매</span></button>
</div>
</div>
</div>

<!-- 에반젤린 -->
